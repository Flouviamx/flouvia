---
export const prerender = false;
import PortalLayout from '../../../layouts/PortalLayout.astro';

const needsSignout = Astro.url.searchParams.has('signout');
---

<PortalLayout title="Access unavailable | Flouvia OS" public>
  <section class="access-state" id="ar-wrap" data-needs-signout={needsSignout ? '1' : null}>
    <div class="access-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
    </div>
    <p class="access-label">Flouvia OS</p>
    <h1>Access unavailable</h1>
    <p class="access-copy">
      This email is not associated with a client workspace yet. If you already work with Flouvia,
      ask us to review your access.
    </p>
    <div class="access-actions">
      <a href="mailto:hola@flouvia.com" class="access-primary">Request access</a>
      <a href="/en/" class="access-secondary">Back to flouvia.com</a>
    </div>
    <p class="access-footnote">Portal access is enabled for authorized email addresses.</p>
  </section>
</PortalLayout>

<style>
  :global(body) { background: #f5f5f7; }
  .access-state {
    width: min(480px, calc(100% - 32px)); margin: auto; padding: 3rem 2.25rem;
    display: flex; flex-direction: column; align-items: center; text-align: center;
    color: #1d1d1f; background: rgba(255,255,255,.92); border: 1px solid rgba(0,0,0,.07);
    border-radius: 28px; box-shadow: 0 24px 70px -48px rgba(0,0,0,.42);
    animation: state-in 280ms cubic-bezier(.25,.1,.25,1) both;
  }
  .access-icon {
    width: 52px; height: 52px; display: grid; place-items: center; margin-bottom: 1.5rem;
    color: #6e6e73; background: rgba(118,118,128,.1); border-radius: 15px;
  }
  .access-icon svg { width: 24px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .access-label { margin: 0 0 .65rem; color: #86868b; font-size: .75rem; font-weight: 600; }
  h1 { margin: 0; font-size: clamp(2rem, 6vw, 2.8rem); line-height: 1.08; letter-spacing: -.045em; font-weight: 700; }
  .access-copy { max-width: 39ch; margin: 1.1rem 0 1.8rem; color: #6e6e73; font-size: .96rem; line-height: 1.55; }
  .access-actions { width: 100%; display: flex; flex-direction: column; gap: .7rem; }
  .access-actions a { min-height: 46px; display: inline-flex; align-items: center; justify-content: center; border-radius: 12px; text-decoration: none; font-size: .88rem; font-weight: 600; transition: transform 120ms ease, background 160ms ease; }
  .access-actions a:active { transform: scale(.98); }
  .access-primary { color: #fff; background: #0071e3; }
  .access-primary:hover { background: #0077ed; }
  .access-secondary { color: #1d1d1f; background: rgba(118,118,128,.1); }
  .access-secondary:hover { background: rgba(118,118,128,.14); }
  .access-footnote { margin: 1.25rem 0 0; color: #8e8e93; font-size: .72rem; }
  @keyframes state-in { from { opacity: 0; transform: translateY(10px); } }
  @media (max-width: 560px) { .access-state { padding: 2.4rem 1.4rem; border-radius: 24px; } }
  @media (prefers-reduced-motion: reduce) { .access-state { animation: none; } }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const wrap = document.getElementById('ar-wrap');
    if (wrap?.dataset.needsSignout !== '1') return;
    const cleanQuery = () => history.replaceState({}, '', window.location.pathname);
    const tryLogout = () => {
      const Clerk = (window as any).Clerk;
      if (!Clerk?.loaded || typeof Clerk.signOut !== 'function') return false;
      Clerk.signOut(() => cleanQuery()).catch(cleanQuery);
      return true;
    };
    if (!tryLogout()) {
      const interval = setInterval(() => { if (tryLogout()) clearInterval(interval); }, 120);
      setTimeout(() => clearInterval(interval), 6000);
    }
  });
</script>
