</style>

<script>
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import { initFluidShaders } from "../../components/blog/FluidShader";

    gsap.registerPlugin(ScrollTrigger);

    document.addEventListener("DOMContentLoaded", () => {
        initFluidShaders();
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        if (!reducedMotion) {
            document.documentElement.classList.add("js-anim");

            // Hero Entrance
            const tl = gsap.timeline({ defaults: { ease: "power4.out", duration: 1.2 }, delay: 0.1 });
            const heroEls = document.querySelectorAll(".hero-anim");
            if(heroEls.length) {
                gsap.set(heroEls, { y: 30, opacity: 0, visibility: "visible" });
                tl.to(heroEls, { y: 0, opacity: 1, stagger: 0.1 });
            }

            // General Sections Entrance
            gsap.utils.toArray(".js-anim-section").forEach((section: any) => {
                gsap.fromTo(section,
                    { y: 40, opacity: 0, visibility: "visible" },
                    {
                        scrollTrigger: {
                            trigger: section,
                            start: "top 85%",
                            toggleActions: "play none none none"
                        },
                        y: 0,
                        opacity: 1,
                        duration: 1.2,
                        ease: "power4.out"
                    }
                );
            });

            // Services Rows Entrance
            gsap.utils.toArray(".js-anim-row").forEach((row: any) => {
                gsap.fromTo(row,
                    { y: 40, opacity: 0, visibility: "visible" },
                    {
                        scrollTrigger: {
                            trigger: row,
                            start: "top 85%",
                            toggleActions: "play none none none"
                        },
                        y: 0,
                        opacity: 1,
                        duration: 1.2,
                        ease: "power4.out"
                    }
                );
            });

            // Removed CTA animation block
        }
    });
</script>
