---
export const prerender = false;
import PortalLayout from '../../../layouts/PortalLayout.astro';
import CustomOAuthCallback from '../../../components/portal/CustomOAuthCallback';
---

<PortalLayout title="Access | Flouvia" public>
    <div class="callback-wrapper">
        <CustomOAuthCallback
            lang="en"
            loginPath="/en/login"
            redirectPath="/en/dashboard"
            client:load
        />
    </div>
</PortalLayout>

<style>
    .callback-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: calc(100vh - 140px);
        background: var(--color-bg-soft, #fcfcfc);
    }
</style>
