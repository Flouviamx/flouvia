---
export const prerender = false;
import PortalLayout from '../../layouts/PortalLayout.astro';
import CustomOAuthCallback from '../../components/portal/CustomOAuthCallback';
const host = Astro.request.headers.get('host') || Astro.url.hostname;
const isOps = host.split(':')[0].toLowerCase() === 'ops.flouvia.com';
---

<PortalLayout title="Acceso | Flouvia" public>
    <div class="callback-wrapper">
        <CustomOAuthCallback
            lang="es"
            loginPath="/login"
            redirectPath={isOps ? '/' : '/dashboard'}
            client:load
        />
    </div>
</PortalLayout>

<style>
    .callback-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: calc(100vh - 140px);
        background: #ffffff;
    }
</style>
