---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';

export const prerender = true;

const title = 'Cord — Cotizaciones B2B con CFDI Automático | Gratis para Empezar';
const description = 'Cord es la plataforma B2B para cotizaciones, pedidos y CFDI 4.0, creada por Flouvia. Gratis para siempre, sin tarjeta. Disponible para cualquier negocio en México.';

const schemaOrg = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": "https://flouvia.com/#organization",
  "makesOffer": {
    "@type": "Offer",
    "itemOffered": {
      "@type": "SoftwareApplication",
      "name": "Cord",
      "url": "https://cord.flouvia.com",
      "applicationCategory": "BusinessApplication",
      "description": "Plataforma B2B de cotizaciones, pedidos y CFDI 4.0, de uso público y gratuito."
    }
  }
};
---

<Layout
    title={title}
    description={description}
    canonicalOverride="https://cord.flouvia.com/"
>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script type="application/ld+json" set:html={JSON.stringify(schemaOrg)} />

    <!-- Simplified Nav -->
    <header class="cord-nav">
        <div class="nav-container">
            <div class="nav-left">
                <a href="/" class="flouvia-mini-logo" aria-label="Flouvia">
                    <svg viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M12 2L2 22h20L12 2z" fill="currentColor"/></svg>
                </a>
                <span class="nav-brand">Cord</span>
            </div>
            <div class="nav-right">
                <a href="https://cord.flouvia.com" class="nav-cta-link">Ir a Cord &rarr;</a>
            </div>
        </div>
    </header>

    <main class="page-cord">
        <!-- 02 — Hero -->
        <section class="hero-teaser">
            <div class="container hero-container text-center">
                <p class="eyebrow">UN PRODUCTO DE FLOUVIA &middot; DISPONIBLE PARA CUALQUIER NEGOCIO</p>
                <h1 class="hero-title">Cord. Cotizaciones B2B<br/>que se aprueban solas.</h1>
                <p class="hero-subhead">Manda cotizaciones con tu marca, tu cliente aprueba en un clic y el CFDI se timbra solo. Gratis para empezar — sin tarjeta, sin aplicar a nada.</p>
                
                <div class="hero-badges">
                    <span class="badge">📩 Notificación cuando la ven</span>
                    <span class="badge">&#10003; Aprobación en un clic</span>
                    <span class="badge">🧾 CFDI 4.0 automático</span>
                </div>

                <div class="hero-actions">
                    <a href="https://cord.flouvia.com/registro" class="btn-primary">Probar Cord gratis &rarr;</a>
                    <a href="https://cord.flouvia.com" class="btn-secondary">Ver una cotización de ejemplo</a>
                </div>
                <p class="hero-microcopy">Gratis hasta 5 cotizaciones &middot; Sin tarjeta &middot; Cualquier negocio puede entrar</p>
            </div>
        </section>

        <!-- 03 — Features -->
        <section class="teaser-features">
            <div class="container features-grid">
                <div class="feature-card">
                    <h3>Tu cliente aprueba sin crear cuenta.</h3>
                    <p>Un link con tu marca. Lo abre, ve el total, aprueba o paga. Cero fricción para que cierren más rápido.</p>
                </div>
                <div class="feature-card">
                    <h3>Sabes el momento exacto en que la ven.</h3>
                    <p>Notificación instantánea cuando tu cliente abre la cotización. Se acabó el "¿ya la revisaste?"</p>
                </div>
                <div class="feature-card">
                    <h3>CFDI 4.0, sin recapturar nada.</h3>
                    <p>De cotización aprobada a factura timbrada ante el SAT, automático, desde la misma pantalla.</p>
                </div>
            </div>
        </section>

        <!-- 04 — Trust strip -->
        <section class="trust-strip">
            <div class="container">
                <p>Construido por Flouvia, la misma firma detrás de portales B2B para distribuidores en México &middot; Usado en La Central de Abastos CDMX: &minus;67% tiempo de procesamiento, +25% ticket promedio</p>
            </div>
        </section>

        <!-- 05 — CTA final -->
        <section class="final-cta text-center">
            <div class="container">
                <p class="eyebrow">EMPIEZA HOY</p>
                <h2>Tu primera cotización, en menos de 10 minutos.</h2>
                <p class="subtext">Sin tarjeta. Plan gratis para siempre. Cualquier negocio B2B en México puede empezar ahora.</p>
                <a href="https://cord.flouvia.com/registro" class="btn-primary btn-large">Crear cuenta gratis en Cord &rarr;</a>
            </div>
        </section>
    </main>

    <Footer />
</Layout>

<style>
/* CSS para el teaser, enfocado en Inter (sin serif) y diseño limpio, Quiet Luxury */
:root {
    --bg-color: #ffffff;
    --text-primary: #0a192f;
    --text-secondary: rgba(10,25,47,0.65);
    --border-color: rgba(10,25,47,0.1);
}

body {
    background-color: var(--bg-color);
    color: var(--text-primary);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    margin: 0;
    padding: 0;
    -webkit-font-smoothing: antialiased;
}

.container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 5%;
}

.text-center { text-align: center; }

.eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
}

/* NAV */
.cord-nav {
    border-bottom: 1px solid var(--border-color);
    padding: 1.2rem 0;
    position: sticky;
    top: 0;
    background: rgba(255,255,255,0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    z-index: 100;
}
.nav-container {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 5%;
}
.nav-left {
    display: flex;
    align-items: center;
    gap: 0.8rem;
}
.flouvia-mini-logo svg {
    width: 20px;
    height: 20px;
    color: var(--text-primary);
}
.nav-brand {
    font-weight: 600;
    font-size: 1.05rem;
    letter-spacing: -0.01em;
}
.nav-cta-link {
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--text-primary);
    text-decoration: none;
    transition: opacity 0.2s ease;
}
.nav-cta-link:hover { opacity: 0.6; }

/* HERO */
.hero-teaser {
    padding: 7rem 0 5rem;
}
.hero-title {
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.035em;
    margin: 0 auto 1.5rem;
    max-width: 900px;
}
.hero-subhead {
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.5;
    color: var(--text-secondary);
    max-width: 700px;
    margin: 0 auto 2.5rem;
}
.hero-badges {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-bottom: 3.5rem;
}
.badge {
    background: rgba(10,25,47,0.03);
    border: 1px solid var(--border-color);
    padding: 0.6rem 1.2rem;
    border-radius: 100px;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-primary);
    box-shadow: 0 2px 5px rgba(0,0,0,0.02);
}
.hero-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 1.5rem;
}
@media (max-width: 600px) {
    .hero-actions {
        flex-direction: column;
        width: 100%;
        max-width: 400px;
        margin-left: auto;
        margin-right: auto;
    }
    .hero-actions a {
        width: 100%;
        justify-content: center;
        display: flex;
    }
}
.btn-primary {
    background: var(--text-primary);
    color: #fff;
    padding: 1.1rem 2rem;
    border-radius: 100px;
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none;
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.4s ease;
}
.btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 24px rgba(10,25,47,0.18);
}
.btn-secondary {
    background: transparent;
    color: var(--text-primary);
    padding: 1.1rem 2rem;
    border-radius: 100px;
    font-size: 1.05rem;
    font-weight: 600;
    text-decoration: none;
    border: 1px solid var(--border-color);
    transition: background 0.2s ease;
}
.btn-secondary:hover {
    background: rgba(10,25,47,0.03);
}
.btn-large {
    font-size: 1.15rem;
    padding: 1.25rem 2.5rem;
}
.hero-microcopy {
    font-size: 0.85rem;
    color: var(--text-secondary);
    opacity: 0.9;
}

/* FEATURES */
.teaser-features {
    padding: 5rem 0;
    border-top: 1px solid var(--border-color);
    border-bottom: 1px solid var(--border-color);
    background: rgba(10,25,47,0.015);
}
.features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 4rem;
}
@media (max-width: 900px) {
    .features-grid { grid-template-columns: 1fr; gap: 3rem; }
}
.feature-card h3 {
    font-size: 1.3rem;
    font-weight: 700;
    letter-spacing: -0.015em;
    margin-bottom: 0.8rem;
    margin-top: 0;
    color: var(--text-primary);
}
.feature-card p {
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
}

/* TRUST STRIP */
.trust-strip {
    padding: 3rem 0;
    text-align: center;
    border-bottom: 1px solid var(--border-color);
}
.trust-strip p {
    font-size: 0.95rem;
    color: var(--text-secondary);
    margin: 0;
    line-height: 1.6;
    max-width: 800px;
    margin: 0 auto;
}

/* FINAL CTA */
.final-cta {
    padding: 8rem 0 9rem;
}
.final-cta h2 {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 800;
    letter-spacing: -0.035em;
    margin: 0 auto 1.5rem;
    max-width: 700px;
}
.final-cta .subtext {
    font-size: 1.15rem;
    color: var(--text-secondary);
    margin: 0 auto 3rem;
    max-width: 600px;
    line-height: 1.5;
}
</style>
