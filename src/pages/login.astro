---
export const prerender = false;
import PortalLayout from '../layouts/PortalLayout.astro';
import LoginUI from '../components/portal/LoginUI.astro';

// Si llegan a flouvia.com/login, mandamos a os.flouvia.com/login
const host = Astro.request.headers.get('host') || Astro.url.hostname;
const hostname = host.split(':')[0].toLowerCase();
const isOps = hostname === 'ops.flouvia.com';
const switchAccount = isOps && Astro.url.searchParams.has('switch');
if (hostname === 'flouvia.com' || hostname === 'www.flouvia.com') {
  return Astro.redirect('https://os.flouvia.com/login', 302);
}

const { userId } = await Astro.locals.auth();
if (userId && !switchAccount) {
  return Astro.redirect(isOps ? '/' : '/dashboard');
}
---

<PortalLayout title="Acceso Privado | Flouvia" public>
    <LoginUI lang="es" product={isOps ? 'OPS' : 'OS'} {switchAccount} />
</PortalLayout>
