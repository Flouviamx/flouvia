---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
---

<Layout title="SM Banners" noindex={true}>
  <!-- Fondo limpio, con scroll si la pantalla es más pequeña que 1200px para que puedas capturarlo a tamaño real -->
  <main style="min-height: 100vh; display: flex; align-items: center; justify-content: center; background: #111111; padding: 40px; overflow: auto;">
    
    <!-- Tarjeta rectangular para el banner (1200x630 fijos para exportar sin pérdida de calidad) -->
    <div 
      class="fluid-target" 
      data-shader-color="#bae6fd"
      data-interactive
      style="position: relative; width: 1200px; height: 630px; flex-shrink: 0; background: #0a192f; border-radius: 24px; box-shadow: 0 40px 80px rgba(0,0,0,0.5); overflow: hidden;"
    >
      <!-- Contenedor relativo por encima del canvas (z-index: 10) para añadir texto o logos -->
      <div style="position: relative; z-index: 10; width: 100%; height: 100%; pointer-events: none; display: flex; align-items: center; justify-content: center;">
        <!-- Logo de Flouvia -->
        <img src="/imgs/logo-flouvia-1.svg" alt="Flouvia" style="width: 340px; height: auto;" />
      </div>
      
    </div>
    
  </main>
</Layout>

<script>
  import { initFluidShaders } from '../components/blog/FluidShader';
  
  // Inicializamos el shader líquido nativo de Flouvia
  document.addEventListener('DOMContentLoaded', () => {
    initFluidShaders();
  });
</script>
