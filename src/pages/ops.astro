---
export const prerender = false;

import PortalLayout from '../layouts/PortalLayout.astro';
import OpsOverview from '../features/ops/overview/OpsOverview';
import {
  isOperatorHost,
  requireOperatorIdentity,
} from '../features/ops/operatorAccess';
import { getOpsOverview } from '../features/ops/overview/opsOverview.service';
import { isPortalAccessError } from '../lib/portalAccess';

if (!isOperatorHost(Astro.url.hostname)) {
  return Astro.redirect('https://ops.flouvia.com/', 302);
}
const legacyClientId = Astro.url.searchParams.get('client');
if (legacyClientId) {
  return Astro.redirect(`/ops/bandeja?client=${encodeURIComponent(legacyClientId)}`, 302);
}

let identity;
try {
  identity = await requireOperatorIdentity(Astro.locals);
} catch (error) {
  if (isPortalAccessError(error) && error.status === 401) {
    return Astro.redirect('/login', 302);
  }
  return Astro.redirect('/acceso-restringido?signout=1&ops=1', 302);
}

const snapshot = await getOpsOverview(identity);
---

<PortalLayout title="Flouvia Ops" mode="ops">
  <OpsOverview initialSnapshot={snapshot} client:load />
</PortalLayout>
