---
export const prerender = false;
import PortalLayout from '../../layouts/PortalLayout.astro';

const needsSignout = Astro.url.searchParams.has('signout');
const isOps = Astro.url.searchParams.has('ops');

if (isOps) {
  return Astro.redirect('/login?switch=1&reason=account', 302);
}
---

<PortalLayout title={`Acceso reservado | Flouvia ${isOps ? 'Ops' : 'OS'}`} public mode={isOps ? 'ops' : 'os'}>
  <section class:list={['access-root', { 'is-ops': isOps }]} id="ar-wrap" data-needs-signout={needsSignout ? '1' : null}>
    <div class="access-inner">
      <div class="access-message">
        <span class="access-kicker">FLOUVIA {isOps ? 'OPS' : 'OS'}</span>
        <h1>{isOps ? 'Esta cuenta no pertenece al equipo.' : 'Este espacio aún no está asignado.'}</h1>
        <p>
          {isOps
            ? 'El centro de operación está reservado a cuentas verificadas con correo @flouvia.com. Tu sesión actual se cerrará de forma segura.'
            : 'El portal solo está disponible para clientes autorizados. Podemos revisar tu invitación y dejar tu espacio listo.'}
        </p>
        <div class="access-system"><span></span>{isOps ? 'CONTROL DE ACCESO ACTIVO' : 'ENTORNO PRIVADO PROTEGIDO'}</div>
      </div>

      <aside class="access-panel">
        <div class="access-panel-brand">
          <img src="/imgs/logo-flouvia-3.svg" alt="Flouvia" />
          <span>{isOps ? 'OPS' : 'OS'}</span>
        </div>
        <div class="access-lock" aria-hidden="true">
          <svg viewBox="0 0 24 24"><rect x="5" y="10" width="14" height="11" rx="3"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
        </div>
        <h2>Acceso reservado</h2>
        <p>{isOps ? 'Cambia a una cuenta del equipo Flouvia para continuar.' : 'Solicita que revisemos el correo de tu invitación.'}</p>
        <div class="access-actions">
          <a href={isOps ? '/login?switch=1' : 'mailto:hola@flouvia.com'} class="access-primary">
            <span>{isOps ? 'Usar otra cuenta' : 'Revisar mi acceso'}</span><span aria-hidden="true">→</span>
          </a>
          <a href="https://flouvia.com/" class="access-secondary">Volver a flouvia.com</a>
        </div>
      </aside>
    </div>
  </section>
</PortalLayout>

<style>
  :global(body) { background: #fff; }
  .access-root { min-height: calc(100dvh - 140px); display: flex; align-items: center; padding: 4.5rem 5% 6rem; background: #fff; color: #1d1d1f; }
  .access-inner { width: min(1080px, 100%); margin: 0 auto; display: grid; grid-template-columns: 1.05fr .95fr; align-items: center; gap: clamp(4rem, 8vw, 8rem); }
  .access-message { max-width: 560px; animation: access-in .7s cubic-bezier(.16,1,.3,1) both; }
  .access-kicker { display: block; margin-bottom: 1.6rem; color: #8a8a8f; font-size: .62rem; font-weight: 750; letter-spacing: .18em; }
  .access-message h1 { max-width: 9.5ch; margin: 0; color: #111113; font-size: clamp(2.8rem, 5.5vw, 5.1rem); font-weight: 760; line-height: .98; letter-spacing: -.06em; }
  .access-message > p { max-width: 47ch; margin: 2rem 0 2.2rem; color: #68686d; font-size: 1rem; line-height: 1.65; }
  .access-system { display: inline-flex; align-items: center; gap: 9px; color: #7c7c81; font-size: .61rem; font-weight: 700; letter-spacing: .13em; }
  .access-system span { width: 7px; height: 7px; border-radius: 50%; background: #13b981; box-shadow: 0 0 0 5px rgba(19,185,129,.08); }
  .access-panel { padding: clamp(2rem, 4vw, 3.25rem); border-radius: 30px; background: #f5f5f7; box-shadow: inset 0 1px 0 rgba(255,255,255,.9), 0 30px 75px -55px rgba(10,25,47,.45); animation: access-in .7s .08s cubic-bezier(.16,1,.3,1) both; }
  .access-panel-brand { display: flex; align-items: center; gap: 15px; margin-bottom: 3.5rem; }
  .access-panel-brand img { width: 112px; height: auto; }
  .access-panel-brand > span { padding-left: 15px; border-left: 1px solid rgba(10,25,47,.15); color: #6e6e73; font-size: .72rem; font-weight: 700; }
  .access-lock { width: 48px; height: 48px; display: grid; place-items: center; margin-bottom: 1.45rem; border-radius: 15px; color: #0a192f; background: rgba(10,25,47,.075); }
  .access-lock svg { width: 22px; fill: none; stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; stroke-linejoin: round; }
  .access-panel h2 { margin: 0 0 .7rem; color: #1d1d1f; font-size: clamp(1.55rem, 2.7vw, 2.15rem); font-weight: 730; letter-spacing: -.045em; }
  .access-panel > p { margin: 0 0 2rem; color: #747478; font-size: .9rem; line-height: 1.55; }
  .access-actions { display: grid; gap: .65rem; }
  .access-actions a { min-height: 50px; display: inline-flex; align-items: center; justify-content: center; border-radius: 15px; text-decoration: none; font-size: .82rem; font-weight: 650; transition: transform .35s cubic-bezier(.16,1,.3,1), background .25s, box-shadow .35s cubic-bezier(.16,1,.3,1); }
  .access-actions a:active { transform: scale(.98); }
  .access-primary { justify-content: space-between !important; padding: 0 1.15rem; color: #fff; background: #0a192f; box-shadow: 0 14px 28px -18px rgba(10,25,47,.75); }
  .access-primary:hover { transform: translateY(-3px); background: #102745; box-shadow: 0 19px 34px -18px rgba(10,25,47,.8); }
  .access-secondary { color: #3a3a3c; background: rgba(118,118,128,.09); }
  .access-secondary:hover { background: rgba(118,118,128,.14); }
  @keyframes access-in { from { opacity: 0; transform: translateY(14px); } }
  @media (max-width: 860px) {
    .access-root { align-items: flex-start; padding-top: 2.5rem; }
    .access-inner { grid-template-columns: 1fr; gap: 3.2rem; }
    .access-message h1 { max-width: 11ch; }
    .access-panel { width: min(100%, 520px); }
  }
  @media (max-width: 560px) {
    .access-root { padding: 2rem 18px 4rem; }
    .access-message h1 { font-size: clamp(2.55rem, 13vw, 3.5rem); }
    .access-panel { padding: 1.6rem; border-radius: 24px; }
    .access-panel-brand { margin-bottom: 2.5rem; }
  }
  @media (prefers-reduced-motion: reduce) { .access-message, .access-panel { animation: none; } }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const wrap = document.getElementById('ar-wrap');
    if (wrap?.dataset.needsSignout !== '1') return;
    const cleanQuery = () => history.replaceState({}, '', window.location.pathname);
    const tryLogout = () => {
      const Clerk = (window as any).Clerk;
      if (!Clerk?.loaded || typeof Clerk.signOut !== 'function') return false;
      Clerk.signOut(() => cleanQuery()).catch(cleanQuery);
      return true;
    };
    if (!tryLogout()) {
      const interval = setInterval(() => { if (tryLogout()) clearInterval(interval); }, 120);
      setTimeout(() => clearInterval(interval), 6000);
    }
  });
</script>
