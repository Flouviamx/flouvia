---
// src/layouts/PortalLayout.astro
import PortalNavbar from '../components/PortalNavbar.astro';
import PortalFooter from '../components/PortalFooter.astro';
import { isOperatorHost, requireOperatorIdentity, type OperatorIdentity } from '../features/ops/operatorAccess';
import { isPortalAccessError } from '../lib/portalAccess';
import { requirePortalIdentity, type PortalIdentity } from '../lib/portalDb';

interface Props {
	title: string;
	public?: boolean;
	mode?: 'os' | 'ops';
}

const { title, public: isPublic = false, mode = 'os' } = Astro.props;
const isEnglish = Astro.url.pathname.startsWith('/en/');
const requestHost = (Astro.request.headers.get('host') || Astro.url.hostname).split(':')[0].toLowerCase();
const product = mode === 'ops' || requestHost === 'ops.flouvia.com' ? 'OPS' : 'OS';
let portalIdentity: PortalIdentity | OperatorIdentity | null = null;

if (!isPublic) {
	Astro.response.headers.set('Cache-Control', 'private, no-store');
	Astro.response.headers.set('Content-Security-Policy', "frame-ancestors 'none'");
	Astro.response.headers.set('Permissions-Policy', 'camera=(), microphone=(), geolocation=()');
	Astro.response.headers.set('Referrer-Policy', 'same-origin');
	Astro.response.headers.set('X-Content-Type-Options', 'nosniff');
	Astro.response.headers.set('X-Frame-Options', 'DENY');
	if (product === 'OPS' && !isOperatorHost(requestHost)) {
		return Astro.redirect('https://ops.flouvia.com/', 302);
	}
	try {
		portalIdentity = product === 'OPS'
			? await requireOperatorIdentity(Astro.locals)
			: await requirePortalIdentity(Astro.locals);
	} catch (error) {
		if (isPortalAccessError(error) && error.status === 401) {
			return Astro.redirect(isEnglish ? '/en/login' : '/login', 302);
		}
		return Astro.redirect(isEnglish ? '/en/access-denied?signout=1' : `/acceso-restringido?signout=1${product === 'OPS' ? '&ops=1' : ''}`, 302);
	}
}
---

<!doctype html>
<html lang={isEnglish ? 'en' : 'es'}>
	<head>
		<meta charset="UTF-8" />

		<!-- Gate de animación: marca <html> ANTES del primer paint para que el navbar
		     parta oculto sin flash. Sin JS o con reduced-motion no se añade → visible. -->
		<script is:inline>
			if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				document.documentElement.classList.add('js-anim');
			}
			// Cambio de idioma: ocultar el body antes del paint para restaurar el scroll
			// sin mostrar el salto desde arriba. El navbar lo revela tras posicionar.
			try {
				if (sessionStorage.getItem('flouviaLangScroll') !== null) {
					document.documentElement.classList.add('lang-restoring');
					setTimeout(function () { document.documentElement.classList.remove('lang-restoring'); }, 1500);
				}
			} catch (e) {}
		</script>

		<meta name="description" content="Portal de Clientes Flouvia" />
		<meta name="robots" content="noindex, nofollow" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />

		<!-- Favicon -->
		<link rel="icon" type="image/png" sizes="512x512" href="/android-touch-icon-512.png" />
		<link rel="icon" type="image/png" sizes="192x192" href="/android-touch-icon.png" />
		<link rel="icon" type="image/svg+xml" href="/favicon-light.svg" id="favicon-tag" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

		<!-- PWA — solo el portal se instala como app -->
		<link rel="manifest" href="/manifest.json" />
		<meta name="theme-color" content="#0a192f" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-title" content="Flouvia Portal" />
		<meta name="apple-mobile-web-app-status-bar-style" content="default" />

		<title>{title}</title>

	</head>
	<body>
		<PortalNavbar
			authenticated={!isPublic && Boolean(portalIdentity)}
			{product}
			minimal={isPublic && product === 'OPS'}
		/>

		<main class="portal-main">
			<slot />
		</main>
		<PortalFooter {product} />
	</body>
</html>

<style is:global>
    /* ============================================================
       Flouvia OS — application shell
       ============================================================ */
    *, *::before, *::after { box-sizing: border-box; }

    [class*="eyebrow"] {
        display: none !important;
    }

    /* Cambio de idioma: oculta el body antes del paint para restaurar el scroll sin
       mostrar el salto desde arriba. El navbar lo revela tras posicionar (o el failsafe). */
    html.lang-restoring body { opacity: 0; }

    html, body {
        width: 100%;
        position: relative;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
        -webkit-tap-highlight-color: transparent;
    }

    ::selection { background: rgba(0, 113, 227, 0.2); color: #1d1d1f; }

    :root {
        --color-bg: #ffffff;
        --color-bg-soft: #fcfcfc;
        --color-blue-icy: #f2f6fb;
        --color-blue-deep: #0a192f;
        --color-glass-blue: rgba(10, 25, 47, 0.88);

        --color-text: #1d1d1f;
        --color-text-muted: #6e6e73;
        --color-border: rgba(0, 0, 0, 0.08);

        --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'SF Pro Text', system-ui, sans-serif;

        --ease-ios: cubic-bezier(0.25, 1, 0.5, 1);
        --ease-spring: cubic-bezier(0.25, 0.1, 0.25, 1);
        --ease-smooth: cubic-bezier(0.16, 1, 0.3, 1);

        /* Tus físicas de la Navbar para que coincidan */
        --ease-pro: cubic-bezier(0.19, 1, 0.22, 1);
        --ease-morph: cubic-bezier(0.25, 0.1, 0.25, 1);
    }

    body {
        background-color: #ffffff;
        color: var(--color-text);
        font-family: var(--font-sans);
        margin: 0;
        min-height: 100dvh;
        display: flex;
        flex-direction: column;
    }

    .portal-main {
        flex-grow: 1;
        padding-top: 140px;
        display: flex;
        flex-direction: column;
    }

    /* TUS CLASES DE IDENTIDAD */
    .flouvia-masterpiece { width: 100%; position: relative; overflow-x: clip; }
    .container { max-width: 1200px; margin: 0 auto; padding: 0 5%; position: relative; }
    .editorial { font-family: var(--font-sans); font-style: normal; font-weight: 650; color: #222; }
    .eyebrow { font-size: 0.65rem; font-weight: 800; letter-spacing: 3px; color: #888; text-transform: uppercase; margin-bottom: 1rem; }

    /* ANIMACIONES */
    .reveal-blur {
        opacity: 0; transform: translateY(10px);
        animation: reveal 0.32s var(--ease-spring) forwards; animation-delay: var(--delay, 0s);
    }
    .reveal-fade {
        opacity: 0; transform: translateY(10px);
        animation: revealFade 0.32s var(--ease-spring) forwards; animation-delay: var(--delay, 0s);
    }

    /* Forzamos que corran en el portal */
    .reveal-blur, .reveal-fade { animation-play-state: running !important; }

    @keyframes reveal { to { opacity: 1; transform: translateY(0); } }
    @keyframes revealFade { to { opacity: 1; transform: translateY(0); } }

    .btn-luxe {
        position: relative; display: inline-flex; background: #0a192f; color: #fff;
        padding: 14px 22px; border-radius: 15px; text-decoration: none; font-size: 0.84rem;
        font-weight: 650; transition: transform 0.35s var(--ease-smooth), background 0.25s, box-shadow .35s var(--ease-smooth); overflow: hidden; justify-content: center;
        box-shadow: 0 12px 26px -15px rgba(10,25,47,.7);
    }
    .btn-luxe:hover { background: #102745; transform: translateY(-3px); box-shadow: 0 18px 32px -15px rgba(10,25,47,.75); }
    .btn-luxe:active { transform: translateY(-1px); }

    .squircle { border-radius: 24px; transform: translateZ(0); overflow: hidden; }

    /* Remove every cursor-following light from legacy portal screens. */
    /* Shared Apple-style surface and tactile controls across legacy screens. */
    .os-card, .bv-card, .up-card, .env-card {
        border-color: rgba(0,0,0,.08) !important;
        background-color: rgba(255,255,255,.94) !important;
        box-shadow: 0 16px 44px -32px rgba(0,0,0,.3) !important;
    }
    .portal-main .os-page { background: transparent !important; }
    .os-card:hover, .bv-card:hover, .up-card:hover, .env-card:hover, .tl-card:hover {
        transform: none !important;
        border-color: rgba(0,0,0,.1) !important;
        box-shadow: 0 18px 48px -34px rgba(0,0,0,.34) !important;
    }
    .sp-submit, .up-submit-btn, .fact-manage-btn, .bv-upload-btn {
        border-radius: 15px !important;
        background: #0a192f !important;
        color: #fff !important;
        box-shadow: 0 12px 26px -15px rgba(10,25,47,.7) !important;
        transition: transform .35s var(--ease-smooth), background .25s, box-shadow .35s var(--ease-smooth) !important;
    }
    .sp-submit:hover, .up-submit-btn:hover, .fact-manage-btn:hover, .bv-upload-btn:hover {
        background: #102745 !important;
        transform: translateY(-3px) !important;
    }
    .sp-submit:active, .up-submit-btn:active, .fact-manage-btn:active, .bv-upload-btn:active {
        transform: translateY(-1px) !important;
    }

    :focus-visible { outline: 2px solid #0071e3; outline-offset: 2px; }

    @media (max-width: 720px) {
        .portal-main { padding-top: 96px; padding-bottom: 0; }
    }

    @media (prefers-reduced-motion: reduce) {
        .reveal-blur, .reveal-fade { opacity: 1; transform: none; animation: none !important; }
    }
</style>
