---
// CordFaqAccordion.astro — mismo acordeón premium que usa cordhq.app
// (componente hermano: flouvia-cord/src/components/landing/FaqAccordion.astro),
// portado a flouvia con sus propios tokens de :root (--color-border, --font-sans,
// --color-blue-deep, --color-text-muted, ya definidos en cord.astro/en/cord.astro).
// Usage: <CordFaqAccordion faqs={[{q,a}]} eyebrow="..." title="..." id="unique" />

interface Props {
    faqs: { q: string; a: string }[];
    eyebrow?: string;
    title?: string;
    id?: string;
    class?: string;
    maxWidth?: string;
}

const {
    faqs,
    eyebrow,
    title,
    id = 'faq',
    class: className = '',
    maxWidth = '820px',
} = Astro.props;

const uid = `cfacc-${id}`;
---

<section class:list={['cf-acc-section', className]} id={id}>
    <div class="cf-acc-wrap" style={`--cf-max-w: ${maxWidth}`}>
        {eyebrow && (
            <p class="cf-acc-eyebrow eyebrow">{eyebrow}</p>
        )}
        {title && (
            <h2 class="cf-acc-title section-heading">{title}</h2>
        )}
        <div class="cf-acc-list" role="list">
            {faqs.map((f, i) => (
                <div class="cf-acc-item" role="listitem">
                    <button
                        class="cf-acc-q"
                        aria-expanded="false"
                        aria-controls={`${uid}-body-${i}`}
                        id={`${uid}-btn-${i}`}
                        type="button"
                    >
                        <span class="cf-acc-q-text">{f.q}</span>
                        <span class="cf-acc-icon" aria-hidden="true">
                            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <line x1="4" y1="10" x2="16" y2="10" stroke="currentColor" stroke-width="1.65" stroke-linecap="round"/>
                                <line class="cf-ico-v" x1="10" y1="4" x2="10" y2="16" stroke="currentColor" stroke-width="1.65" stroke-linecap="round"/>
                            </svg>
                        </span>
                    </button>
                    <div
                        class="cf-acc-body"
                        id={`${uid}-body-${i}`}
                        role="region"
                        aria-labelledby={`${uid}-btn-${i}`}
                    >
                        <div class="cf-acc-body-inner">
                            <p class="cf-acc-a">{f.a}</p>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>
</section>

<style>
.cf-acc-section {
    padding: 6rem 5%;
    /* Una sola curva: suave, decelerada, SIN overshoot (misma familia que --ease-smooth). */
    --cf-ease: var(--ease-smooth, cubic-bezier(0.16, 1, 0.3, 1));
}
.cf-acc-wrap { max-width: var(--cf-max-w, 820px); margin: 0 auto; }

.cf-acc-eyebrow { text-align: center; }
.cf-acc-title { margin-bottom: 3rem; }

.cf-acc-list {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
}

/* ── Card ── */
.cf-acc-item {
    border: 1px solid rgba(10, 25, 47, 0.09);
    border-radius: 15px;
    background: #ffffff;
    overflow: hidden;
    transition:
        border-color 0.45s var(--cf-ease),
        box-shadow 0.55s var(--cf-ease),
        background 0.45s var(--cf-ease);
}
.cf-acc-item:hover { border-color: rgba(10, 25, 47, 0.16); }
.cf-acc-item.is-open {
    border-color: rgba(10, 25, 47, 0.13);
    background: #fcfcfd;
    box-shadow: 0 20px 44px -28px rgba(10, 25, 47, 0.2);
}

.cf-acc-q {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.25rem;
    width: 100%;
    padding: 1.3rem 1.35rem;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    font-family: var(--font-sans);
    font-size: 1.06rem;
    font-weight: 600;
    color: var(--color-text, #050505);
    transition: color 0.3s var(--cf-ease);
    outline: none;
}
.cf-acc-q:focus-visible {
    outline: 2px solid rgba(10, 25, 47, 0.35);
    outline-offset: -3px;
    border-radius: 15px;
}
.cf-acc-q:hover { color: #050505; }
.cf-acc-item.is-open .cf-acc-q { color: #050505; }

.cf-acc-icon {
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid rgba(10, 25, 47, 0.12);
    display: flex;
    align-items: center;
    justify-content: center;
    color: #9aa3b2;
    background: transparent;
    transition:
        background 0.45s var(--cf-ease),
        border-color 0.45s var(--cf-ease),
        color 0.45s var(--cf-ease);
}
.cf-acc-icon svg { width: 15px; height: 15px; display: block; overflow: visible; }
.cf-acc-q:hover .cf-acc-icon {
    background: rgba(10, 25, 47, 0.05);
    border-color: rgba(10, 25, 47, 0.2);
    color: var(--color-blue-deep, #0a192f);
}
.cf-acc-item.is-open .cf-acc-icon {
    background: var(--color-blue-deep, #0a192f);
    border-color: var(--color-blue-deep, #0a192f);
    color: #fff;
}

/* + → −  : la barra vertical se retrae al centro. Sin rotación del ícono. */
.cf-ico-v {
    transform-origin: 10px 10px;
    transition: transform 0.4s var(--cf-ease);
}
.cf-acc-item.is-open .cf-ico-v { transform: scaleY(0); }

.cf-acc-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.5s var(--cf-ease);
}
.cf-acc-item.is-open .cf-acc-body { grid-template-rows: 1fr; }
.cf-acc-body-inner { overflow: hidden; min-height: 0; }

.cf-acc-a {
    margin: 0;
    font-size: 1rem;
    line-height: 1.72;
    color: var(--color-text-muted, #555556);
    max-width: 680px;
    padding: 0 1.35rem;
    opacity: 0;
    transform: translateY(-6px);
    transition:
        opacity   0.4s var(--cf-ease),
        transform 0.4s var(--cf-ease),
        padding-bottom 0.45s var(--cf-ease);
}
.cf-acc-item.is-open .cf-acc-a {
    opacity: 1;
    transform: translateY(0);
    padding-bottom: 1.55rem;
    transition-delay: 0.06s;
}

@media (prefers-reduced-motion: reduce) {
    .cf-acc-item,
    .cf-acc-icon,
    .cf-ico-v,
    .cf-acc-body,
    .cf-acc-a,
    .cf-acc-q { transition: none; }
}

@media (max-width: 680px) {
    .cf-acc-section { padding: 4.5rem 5%; }
    .cf-acc-q { font-size: 1rem; padding: 1.15rem 1.1rem; gap: 0.9rem; }
    .cf-acc-a { font-size: 0.95rem; padding: 0 1.1rem; }
    .cf-acc-item.is-open .cf-acc-a { padding-bottom: 1.3rem; }
    .cf-acc-icon { width: 30px; height: 30px; }
    .cf-acc-icon svg { width: 14px; height: 14px; }
}
</style>

<script>
// Acordeón uno-a-la-vez, agrupado por lista (permite varias instancias por página)
document.querySelectorAll<HTMLElement>('.cf-acc-list').forEach((list) => {
    const items = Array.from(list.querySelectorAll<HTMLElement>('.cf-acc-item'));
    items.forEach((item) => {
        const btn = item.querySelector<HTMLButtonElement>('.cf-acc-q');
        if (!btn) return;
        btn.addEventListener('click', () => {
            const willOpen = !item.classList.contains('is-open');
            items.forEach((other) => {
                other.classList.remove('is-open');
                other.querySelector<HTMLButtonElement>('.cf-acc-q')?.setAttribute('aria-expanded', 'false');
            });
            if (willOpen) {
                item.classList.add('is-open');
                btn.setAttribute('aria-expanded', 'true');
            }
        });
    });
});
</script>
