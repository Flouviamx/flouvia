---
// Aviso de cookies discreto (opción mínima, sin bloqueo de carga). Solo sitio público.
// Se descarta con "Entendido" y recuerda la elección en localStorage.
import { getLangFromUrl } from '../i18n/utils';

const isEn = getLangFromUrl(Astro.url) === 'en';

const t = isEn
  ? {
      text: 'We use cookies to measure and improve the site.',
      more: 'Learn more',
      ok: 'Got it',
      href: '/en/privacy#cookies',
      aria: 'Cookie notice',
    }
  : {
      text: 'Usamos cookies para medir y mejorar el sitio.',
      more: 'Más información',
      ok: 'Entendido',
      href: '/privacidad#cookies',
      aria: 'Aviso de cookies',
    };
---

<div id="cookie-notice" class="cookie-notice" role="region" aria-label={t.aria} hidden>
  <p class="cookie-notice__text">
    {t.text}
    <a class="cookie-notice__link" href={t.href}>{t.more}</a>
  </p>
  <button type="button" class="cookie-notice__btn" id="cookie-notice-accept">{t.ok}</button>
</div>

<style>
  .cookie-notice {
    position: fixed;
    left: 50%;
    bottom: max(1rem, env(safe-area-inset-bottom));
    transform: translateX(-50%) translateY(12px);
    z-index: 9998;
    display: flex;
    align-items: center;
    gap: 1rem;
    width: min(680px, calc(100vw - 2rem));
    padding: 0.85rem 0.9rem 0.85rem 1.25rem;
    border-radius: 16px;
    background: #0a192f;
    color: #e9eef6;
    box-shadow: 0 18px 44px -16px rgba(0, 0, 0, 0.55);
    font-size: 0.85rem;
    line-height: 1.5;
    opacity: 0;
    transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cookie-notice.is-visible {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }

  .cookie-notice__text { margin: 0; flex: 1; }

  .cookie-notice__link {
    color: #ffffff;
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: nowrap;
    margin-left: 0.35rem;
  }
  .cookie-notice__link:hover { opacity: 0.8; }

  .cookie-notice__btn {
    flex-shrink: 0;
    appearance: none;
    border: 0;
    cursor: pointer;
    padding: 0.6rem 1.1rem;
    min-height: 40px;
    border-radius: 10px;
    background: #ffffff;
    color: #0a192f;
    font: inherit;
    font-weight: 650;
    font-size: 0.82rem;
    transition: transform 0.2s ease, background 0.2s ease;
  }
  .cookie-notice__btn:hover { background: #e9eef6; transform: translateY(-1px); }
  .cookie-notice__btn:active { transform: translateY(0); }

  @media (max-width: 560px) {
    .cookie-notice {
      left: 0.75rem;
      right: 0.75rem;
      width: auto;
      transform: translateY(12px);
      flex-direction: column;
      align-items: stretch;
      gap: 0.7rem;
      padding: 1rem 1.1rem;
    }
    .cookie-notice.is-visible { transform: translateY(0); }
    .cookie-notice__btn { width: 100%; min-height: 44px; }
    .cookie-notice__link { display: inline-block; margin-left: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .cookie-notice,
    .cookie-notice.is-visible { transition: opacity 0.2s linear; transform: translateX(-50%); }
    .cookie-notice__btn:hover { transform: none; }
    @media (max-width: 560px) {
      .cookie-notice,
      .cookie-notice.is-visible { transform: none; }
    }
  }
</style>

<script is:inline>
  (function () {
    var KEY = 'flouvia-cookie-notice-v1';
    var el = document.getElementById('cookie-notice');
    if (!el) return;

    var dismissed = false;
    try { dismissed = localStorage.getItem(KEY) === '1'; } catch (e) {}
    if (dismissed) { el.remove(); return; }

    el.hidden = false;
    requestAnimationFrame(function () {
      requestAnimationFrame(function () { el.classList.add('is-visible'); });
    });

    var btn = document.getElementById('cookie-notice-accept');
    if (btn) {
      btn.addEventListener('click', function () {
        try { localStorage.setItem(KEY, '1'); } catch (e) {}
        el.classList.remove('is-visible');
        var done = function () { el.remove(); };
        el.addEventListener('transitionend', done, { once: true });
        setTimeout(done, 600);
      });
    }
  })();
</script>
