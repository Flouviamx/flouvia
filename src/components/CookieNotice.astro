---
// Aviso de cookies discreto (opción mínima, sin bloqueo de carga). Solo sitio público.
// Se descarta con "Entendido" y recuerda la elección en localStorage.
// Estilo: Liquid Glass alineado con el Navbar (pill translúcido + botón navy con shimmer).
import { getLangFromUrl } from '../i18n/utils';

const isEn = getLangFromUrl(Astro.url) === 'en';

const t = isEn
  ? {
      eyebrow: 'Cookies',
      text: 'We use cookies to measure and improve the site.',
      more: 'Learn more',
      ok: 'Got it',
      href: '/en/privacy#cookies',
      aria: 'Cookie notice',
    }
  : {
      eyebrow: 'Cookies',
      text: 'Usamos cookies para medir y mejorar el sitio.',
      more: 'Más información',
      ok: 'Entendido',
      href: '/privacidad#cookies',
      aria: 'Aviso de cookies',
    };
---

<div id="cookie-notice" class="cookie-notice" role="region" aria-label={t.aria} hidden>
  <div class="cookie-notice__shimmer" aria-hidden="true"></div>

  <span class="cookie-notice__eyebrow">
    <span class="cookie-notice__dot" aria-hidden="true"></span>
    {t.eyebrow}
  </span>

  <p class="cookie-notice__text">
    {t.text}
    <a class="cookie-notice__link" href={t.href}>{t.more}</a>
  </p>

  <button type="button" class="cookie-notice__btn" id="cookie-notice-accept">
    <span>{t.ok}</span>
    <svg class="cookie-notice__arrow" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="5" y1="19" x2="19" y2="5"></line><polyline points="9 5 19 5 19 15"></polyline></svg>
  </button>
</div>

<style>
  :root {
    --cn-navy: #0a192f;
    --cn-ease-expo: cubic-bezier(0.16, 1, 0.3, 1);
    --cn-ease-spring: cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* ── PILL — Liquid Glass, mismo lenguaje que el .glass-pill del Navbar ── */
  .cookie-notice {
    position: fixed;
    left: 50%;
    bottom: max(1.15rem, env(safe-area-inset-bottom));
    transform: translateX(-50%) translateY(12px);
    z-index: 9998;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    width: min(660px, calc(100vw - 2rem));
    padding: 0.55rem 0.6rem 0.55rem 1.15rem;
    border-radius: 100px;
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.72) 0%, rgba(255, 255, 255, 0.5) 48%, rgba(255, 255, 255, 0.56) 100%);
    backdrop-filter: blur(30px) saturate(1.9) brightness(1.04);
    -webkit-backdrop-filter: blur(30px) saturate(1.9) brightness(1.04);
    border: 1px solid rgba(255, 255, 255, 0.55);
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.95),
      inset 0 0 0 0.5px rgba(255, 255, 255, 0.4),
      inset 0 -6px 14px rgba(255, 255, 255, 0.18),
      0 10px 34px rgba(10, 25, 47, 0.1),
      0 2px 6px rgba(10, 25, 47, 0.06);
    color: rgba(10, 25, 47, 0.72);
    font-size: 0.82rem;
    line-height: 1.5;
    overflow: hidden;
    opacity: 0;
    transition:
      opacity 0.5s var(--cn-ease-expo),
      transform 0.5s var(--cn-ease-expo),
      box-shadow 0.7s var(--cn-ease-spring),
      border-color 0.7s var(--cn-ease-spring);
  }
  .cookie-notice.is-visible {
    opacity: 1;
    transform: translateX(-50%) translateY(0);
  }
  .cookie-notice:hover {
    border-color: rgba(255, 255, 255, 0.7);
    box-shadow:
      inset 0 1px 1px rgba(255, 255, 255, 0.98),
      inset 0 0 0 0.5px rgba(255, 255, 255, 0.5),
      inset 0 -6px 14px rgba(255, 255, 255, 0.22),
      0 18px 50px rgba(10, 25, 47, 0.14),
      0 3px 8px rgba(10, 25, 47, 0.07);
  }

  /* shimmer sweep — igual que .pill-shimmer del Navbar */
  .cookie-notice__shimmer {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(105deg, transparent 30%, rgba(255, 255, 255, 0.5) 50%, transparent 70%);
    transform: translateX(-100%);
    pointer-events: none;
    z-index: 0;
    transition: transform 0s;
  }
  .cookie-notice:hover .cookie-notice__shimmer {
    transform: translateX(100%);
    transition: transform 0.6s var(--cn-ease-expo);
  }

  /* ── EYEBROW — microtipografía Inter en mayúsculas, como el top-bar del Navbar ── */
  .cookie-notice__eyebrow {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-sans, 'Inter', system-ui, sans-serif);
    font-size: 8px;
    font-weight: 800;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(10, 25, 47, 0.45);
  }
  .cookie-notice__dot {
    width: 5px;
    height: 5px;
    border-radius: 100px;
    background: var(--cn-navy);
    box-shadow: 0 0 0 3px rgba(10, 25, 47, 0.08);
  }

  .cookie-notice__text {
    position: relative;
    z-index: 1;
    margin: 0;
    flex: 1;
  }

  .cookie-notice__link {
    color: var(--cn-navy);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
    text-decoration-color: rgba(10, 25, 47, 0.35);
    white-space: nowrap;
    margin-left: 0.35rem;
    transition: text-decoration-color 0.3s ease, opacity 0.3s ease;
  }
  .cookie-notice__link:hover {
    text-decoration-color: var(--cn-navy);
  }

  /* ── BOTÓN — clon del .btn-contact del Navbar (navy, mayúsculas, flecha, shimmer) ── */
  .cookie-notice__btn {
    position: relative;
    z-index: 1;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    appearance: none;
    cursor: pointer;
    padding: 10px 18px;
    min-height: 38px;
    border-radius: 100px;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: var(--cn-navy);
    color: #fff;
    font-family: var(--font-sans, 'Inter', system-ui, sans-serif);
    font-size: 9.5px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    overflow: hidden;
    box-shadow: 0 4px 16px rgba(10, 25, 47, 0.2), inset 0 1px 0 rgba(255, 255, 255, 0.08);
    transition: transform 0.4s var(--cn-ease-expo), box-shadow 0.4s var(--cn-ease-expo), background 0.3s ease;
  }
  .cookie-notice__btn::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(105deg, transparent 20%, rgba(255, 255, 255, 0.09) 50%, transparent 80%);
    transform: translateX(-100%);
    transition: transform 0s;
  }
  .cookie-notice__btn:hover::before {
    transform: translateX(100%);
    transition: transform 0.55s var(--cn-ease-expo);
  }
  .cookie-notice__btn:hover {
    transform: translateY(-2px) scale(1.02);
    background: #152641;
    box-shadow: 0 12px 32px rgba(10, 25, 47, 0.3), inset 0 1px 0 rgba(255, 255, 255, 0.12);
  }
  .cookie-notice__btn:active {
    transform: translateY(0) scale(0.99);
  }
  .cookie-notice__arrow {
    flex-shrink: 0;
    transition: transform 0.4s var(--cn-ease-expo);
  }
  .cookie-notice__btn:hover .cookie-notice__arrow {
    transform: translate(2px, -2px);
  }

  @media (max-width: 560px) {
    .cookie-notice {
      left: 0.75rem;
      right: 0.75rem;
      width: auto;
      transform: translateY(12px);
      flex-direction: column;
      align-items: flex-start;
      gap: 0.7rem;
      padding: 1rem 1.15rem;
      border-radius: 24px;
    }
    .cookie-notice.is-visible {
      transform: translateY(0);
    }
    .cookie-notice__btn {
      width: 100%;
      justify-content: center;
      min-height: 44px;
      font-size: 10px;
    }
    .cookie-notice__link {
      display: inline-block;
      margin-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cookie-notice,
    .cookie-notice.is-visible {
      transition: opacity 0.2s linear;
      transform: translateX(-50%);
    }
    .cookie-notice__shimmer {
      display: none;
    }
    .cookie-notice__btn:hover,
    .cookie-notice__btn:active {
      transform: none;
    }
    .cookie-notice__btn:hover .cookie-notice__arrow {
      transform: none;
    }
    @media (max-width: 560px) {
      .cookie-notice,
      .cookie-notice.is-visible {
        transform: none;
      }
    }
  }
</style>

<script is:inline>
  (function () {
    var KEY = 'flouvia-cookie-notice-v1';
    var el = document.getElementById('cookie-notice');
    if (!el) return;

    var dismissed = false;
    try { dismissed = localStorage.getItem(KEY) === '1'; } catch (e) {}
    if (dismissed) { el.remove(); return; }

    el.hidden = false;
    requestAnimationFrame(function () {
      requestAnimationFrame(function () { el.classList.add('is-visible'); });
    });

    var btn = document.getElementById('cookie-notice-accept');
    if (btn) {
      btn.addEventListener('click', function () {
        try { localStorage.setItem(KEY, '1'); } catch (e) {}
        el.classList.remove('is-visible');
        var done = function () { el.remove(); };
        el.addEventListener('transitionend', done, { once: true });
        setTimeout(done, 600);
      });
    }
  })();
</script>
