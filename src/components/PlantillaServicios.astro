        .svc-title-row { flex-direction: column; align-items: flex-start; gap: 1rem; margin-bottom: 1rem; }
        .svc-title { font-size: 2rem; margin-bottom: 0; }
        .svc-desc { font-size: 1.05rem; }
        .svc-proof { margin-bottom: 2rem; font-size: 0.92rem; }
        .svc-caps { margin-bottom: 2rem; }
        .svc-cap { padding: 1.3rem 0; }
        .svc-stack { flex-direction: column; align-items: flex-start; gap: 0.75rem; }

        .why-flouvia-hardware { padding: 4rem 0; }
        .wf-header { margin-bottom: 3rem; }
        /* cards "por qué nuestra firma" → acordeón vertical en móvil */
        .wf-accordion { flex-direction: column; height: auto; border-radius: 16px; margin: 0; box-shadow: none; border: 1px solid rgba(0,0,0,0.06); }
        .wf-acc-panel { 
            flex: none; border-right: none; 
            border-bottom: 1px solid rgba(255,255,255,0.06); 
            height: 70px; transition: height 0.6s cubic-bezier(0.16, 1, 0.3, 1), background 0.4s ease;
            flex-direction: column;
        }
        .wf-acc-panel:last-child { border-bottom: none; }
        .wf-acc-panel.active { flex: none; height: 360px; }
        .wf-acc-collapsed { 
            width: 100%; height: 70px; bottom: auto; right: 0; 
            justify-content: flex-start; padding-left: 1.5rem;
        }
        .wf-acc-panel.active .wf-acc-collapsed { opacity: 0; }
        .wf-acc-num { transform: none; font-size: 1.4rem; }
        
        .wf-acc-content { 
            left: 0; top: 0; bottom: auto;
            width: 100%; min-width: 100%; height: 100%;
            padding: 2rem 1.5rem; justify-content: center;
            transform: translateY(20px);
        }
        .wf-acc-panel.active .wf-acc-content { transform: translateY(0); }
        .wf-acc-idx { font-size: 2.2rem; margin-bottom: 1rem; }
        .wf-acc-content h3 { font-size: 1.4rem; margin-bottom: 0.8rem; }
        .wf-acc-content p { font-size: 1rem; max-width: 100%; }

        .comparison-section { padding: 4rem 0; }
        .cmp-header { flex-direction: column; align-items: flex-start; gap: 1.5rem; margin-bottom: 2.5rem; }
        .cmp-header .section-sub { max-width: 100%; }
        /* tabla comparativa → scroll horizontal limpio (borde a borde) */
        .cmp-scroll { overflow-x: auto; -webkit-overflow-scrolling: touch; margin: 0 -1.5rem; padding: 0 1.5rem 0.75rem; scrollbar-width: none; }
        .cmp-scroll::-webkit-scrollbar { display: none; }
        .cmp-frame { min-width: 560px; max-width: none; }
        .cmp-table th, .cmp-table td { padding: 1rem; font-size: 0.82rem; }
        .cmp-table thead th { font-size: 0.56rem; letter-spacing: 1px; }
        .cmp-table tbody th[scope="row"] { width: 28%; }
        
        .faq-section { padding: 5rem 0; }
        .faq-heading { font-size: 2.2rem; }
        .faq-q { font-size: 1.1rem; padding: 1.5rem 0; gap: 1rem; }
        .faq-a-inner { padding: 0 1rem 1.5rem 0; }
        .faq-a-inner p { font-size: 0.95rem; }

        .cta-final-clean { padding: 2rem 0 6rem 0; }
        .cta-box-refined { padding: 3rem 1.6rem; border-radius: 28px; text-align: center; }
        .cta-flex { flex-direction: column; align-items: stretch; text-align: left; }
        .cta-text { max-width: 100%; }
        .cta-body { margin-left: auto; margin-right: auto; }
        .cta-title { font-size: 1.7rem; }
        .btn-luxe-main { width: 100%; justify-content: center; margin-top: 1.5rem; }
    }
</style>

<script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    // Recalcular posiciones tras fuentes + carga para que los triggers ya pasados disparen.
    const robustRefresh = () => {
        const winLoad = new Promise<void>((resolve) => {
            if (document.readyState === 'complete') resolve();
            else window.addEventListener('load', () => resolve(), { once: true });
        });
        const fontsReady = (document as any).fonts?.ready ?? Promise.resolve();
        Promise.all([winLoad, fontsReady]).then(() => {
            setTimeout(() => ScrollTrigger.refresh(), 120);
        });
    };
    robustRefresh();

    document.addEventListener('DOMContentLoaded', () => {
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduced) return;

        const EASE = 'power2.out';
        const DUR = 0.9;
        const Y = 14;

        /* HERO — entrada en carga (gate .js-anim ya lo tiene en opacity:0) */
        const heroAnim = gsap.utils.toArray<HTMLElement>('.hero-anim');
        if (heroAnim.length) {
            gsap.set(heroAnim, { opacity: 0, y: 12 });
            gsap.timeline({ defaults: { ease: 'power2.out' } })
                .to('.hero-status',             { opacity: 1, y: 0, duration: 0.9 }, 0)
                .to('.hero-text-zone .eyebrow', { opacity: 1, y: 0, duration: 0.9 }, 0.1)
                .to('.hero-title',              { opacity: 1, y: 0, duration: 1.1 }, 0.2)
                .to('.hero-bottom',             { opacity: 1, y: 0, duration: 1.0 }, 0.42);
        }

        /* Reveal robusto (sin parpadeo): oculta con set, revela una vez en onEnter. */
        const reveal = (
            targets: string | HTMLElement | NodeListOf<Element> | HTMLElement[],
            opts: { trigger?: string | HTMLElement; start?: string; y?: number; dur?: number; stagger?: number; delay?: number } = {}
        ) => {
            const els = gsap.utils.toArray<HTMLElement>(targets as any);
            if (!els.length) return;
            const y = opts.y ?? Y;
            gsap.set(els, { opacity: 0, y });
            ScrollTrigger.create({
                trigger: opts.trigger ?? els[0],
                start: opts.start ?? 'top 85%',
                once: true,
                onEnter: () => gsap.to(els, {
                    opacity: 1, y: 0, duration: opts.dur ?? DUR, ease: EASE,
                    stagger: opts.stagger ?? 0.08, delay: opts.delay ?? 0,
                    clearProps: 'transform,opacity',
                }),
            });
        };
        const revealEach = (selector: string, opts: { start?: string; y?: number; dur?: number } = {}) => {
            gsap.utils.toArray<HTMLElement>(selector).forEach(el => {
                reveal(el, { trigger: el, start: opts.start, y: opts.y, dur: opts.dur, stagger: 0 });
            });
        };

        const mm = gsap.matchMedia();

        /* Parallax leve del hero (solo desktop) */
        mm.add('(min-width: 769px)', () => {
            const heroParallax = document.getElementById('hero-parallax');
            if (heroParallax) {
                gsap.to(heroParallax, {
                    yPercent: 5, opacity: 0.85, ease: 'none',
                    scrollTrigger: { trigger: '.hero-grand', start: 'top top', end: 'bottom 30%', scrub: 1 },
                });
            }
        });

        /* Encabezados + eyebrows */
        revealEach('section:not(.hero-grand) .eyebrow', { y: 10, dur: 0.9, start: 'top 90%' });
        revealEach('.section-heading', { y: 16, dur: 1.0, start: 'top 88%' });

        /* PHILOSOPHY (dark) — líneas + columnas */
        const bp = document.querySelector<HTMLElement>('.philosophy-blueprint');
        if (bp) {
            const lineTop = bp.querySelector<HTMLElement>('.bp-line-top');
            const lineBottom = bp.querySelector<HTMLElement>('.bp-line-bottom');
            const lineYs = bp.querySelectorAll<HTMLElement>('.bp-line-y');
            const badge = bp.querySelector<HTMLElement>('.p-badge');
            const title = bp.querySelector<HTMLElement>('.p-title');
            const btn = bp.querySelector<HTMLElement>('.sleek-btn-light');
            const cols = bp.querySelectorAll<HTMLElement>('.bp-col:not(.bp-header-col) .bp-content');

            if (lineTop) gsap.set(lineTop, { width: 0 });
            if (lineBottom) gsap.set(lineBottom, { width: 0 });
            gsap.set(lineYs, { height: 0 });
            const fade = [badge, title, btn].filter(Boolean) as HTMLElement[];
            gsap.set(fade, { opacity: 0, y: 16 });
            gsap.set(cols, { opacity: 0, y: 20 });

            const tl = gsap.timeline({ scrollTrigger: { trigger: bp, start: 'top 82%', once: true } });
            if (lineTop) tl.to(lineTop, { width: '100%', duration: 1.2, ease: 'power3.inOut' }, 0);
            if (lineBottom) tl.to(lineBottom, { width: '100%', duration: 1.2, ease: 'power3.inOut' }, 0.15);
            lineYs.forEach((l, i) => tl.to(l, { height: '100%', duration: 1.0, ease: 'power3.inOut' }, 0.3 + i * 0.08));
            tl.to(fade, { opacity: 1, y: 0, duration: DUR, ease: EASE, stagger: 0.1 }, 0.25);
            tl.to(cols, { opacity: 1, y: 0, duration: DUR, ease: EASE, stagger: 0.1 }, 0.4);
        }

        /* SERVICIOS — índice editorial (capítulo por servicio) */
        document.querySelectorAll<HTMLElement>('.svc-chapter').forEach((row) => {
            const head = row.querySelectorAll<HTMLElement>('.svc-head, .svc-title, .svc-desc');
            const caps = row.querySelectorAll<HTMLElement>('.svc-cap');
            const stack = row.querySelector<HTMLElement>('.svc-stack');

            gsap.set(head, { opacity: 0, y: 16 });
            gsap.set(caps, { opacity: 0, y: 16 });
            if (stack) gsap.set(stack, { opacity: 0, y: 10 });

            const tl = gsap.timeline({ scrollTrigger: { trigger: row, start: 'top 82%', once: true } });
            tl.to(head, { opacity: 1, y: 0, duration: DUR, ease: EASE, stagger: 0.07, clearProps: 'transform,opacity' }, 0);
            tl.to(caps, { opacity: 1, y: 0, duration: DUR, ease: EASE, stagger: 0.06, clearProps: 'transform,opacity' }, 0.2);
            if (stack) tl.to(stack, { opacity: 1, y: 0, duration: DUR, ease: EASE, clearProps: 'transform,opacity' }, 0.45);
        });

        /* ACCORDION "POR QUÉ NUESTRA FIRMA" */
        const accPanels = document.querySelectorAll<HTMLElement>('.wf-acc-panel');
        accPanels.forEach(panel => {
            panel.addEventListener('click', () => {
                if(panel.classList.contains('active')) return;
                accPanels.forEach(p => p.classList.remove('active'));
                panel.classList.add('active');
            });
        });
        
        reveal('.wf-accordion', { trigger: '.why-flouvia-hardware', y: 28, dur: 1.0, start: 'top 82%' });

        /* COMPARISON table */
        reveal('.cmp-scroll', { trigger: '.comparison-section', y: 24, dur: 1.0, start: 'top 80%' });

        // ── Animación y lógica del FAQ (Apple-style) ──
        const ctaCard = document.getElementById('svc-cta-card');
        if (ctaCard) reveal(ctaCard.querySelectorAll('.cta-text > *, .btn-luxe-main'), { trigger: ctaCard, y: 14, stagger: 0.08, start: 'top 86%' });

        const faqHead = document.getElementById('faq-header');
        if (faqHead) reveal(faqHead.querySelectorAll('.faq-heading, .faq-sub'), { trigger: '.faq-section', y: 14, stagger: 0.08, start: 'top 82%' });
        reveal('.faq-item', { trigger: '#faq-list', y: 18, dur: 0.8, stagger: 0.06, start: 'top 86%' });

        const faqItems = document.querySelectorAll('.faq-item');
        faqItems.forEach(item => {
            const q = item.querySelector('.faq-q');
            const a = item.querySelector('.faq-a');
            
            q?.addEventListener('click', () => {
            const isOpen = item.classList.contains('is-open');
            
            // Cerrar otros
            faqItems.forEach(other => {
                if (other !== item && other.classList.contains('is-open')) {
                other.classList.remove('is-open');
                other.querySelector('.faq-q')?.setAttribute('aria-expanded', 'false');
                gsap.to(other.querySelector('.faq-a'), { height: 0, opacity: 0, duration: 0.5, ease: 'power3.inOut' });
                }
            });

            // Toggle actual
            if (isOpen) {
                item.classList.remove('is-open');
                q.setAttribute('aria-expanded', 'false');
                gsap.to(a, { height: 0, opacity: 0, duration: 0.5, ease: 'power3.inOut' });
            } else {
                item.classList.add('is-open');
                q.setAttribute('aria-expanded', 'true');
                gsap.to(a, { height: 'auto', opacity: 1, duration: 0.7, ease: 'power3.out' });
            }
            });
        });
    });

</script>
