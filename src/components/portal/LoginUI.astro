---
// src/components/portal/LoginUI.astro
import CustomSignIn from './CustomSignIn';
import { useTranslations } from '../../i18n/utils';

interface Props {
  lang: 'es' | 'en';
  product?: 'OS' | 'OPS';
  switchAccount?: boolean;
}

const { lang, product = 'OS', switchAccount = false } = Astro.props;
const t = useTranslations(lang);
const isEn = lang === 'en';
const isOps = product === 'OPS';
const redirectPath = isOps ? '/' : (isEn ? '/en/dashboard' : '/dashboard');
const callbackPath = isEn ? '/en/login/sso-callback' : '/login/sso-callback';
---

<section class:list={['login-root', { 'is-ops': isOps }]}>
  <div class="login-inner">
    <div class="brand-col">
      <span class="login-anim eyebrow">{isOps ? 'FLOUVIA · OPERACIÓN' : t('login.eyebrow')}</span>

      <h1 class="login-anim brand-heading">
        {isOps ? <>Todo el trabajo,<br />en control.</> : <>{t('login.title1')}<br />{t('login.title2')}</>}
      </h1>

      <p class="login-anim brand-desc">
        {isOps
          ? 'Responde a clientes, ordena decisiones y actualiza cada proyecto desde un solo lugar.'
          : t('login.desc')}
      </p>

      <div class="login-anim access-note">
        <span class="access-note-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5" /></svg>
        </span>
        <p>
        {isOps
          ? 'Acceso para el equipo Flouvia y la cuenta autorizada del propietario.'
            : (isEn ? 'Secure access for authorized client accounts.' : 'Acceso seguro para cuentas de cliente autorizadas.')}
        </p>
      </div>
    </div>

    <div class="form-col">
      <div class="login-anim form-wrap">
        <span class="form-eyebrow">{isOps ? 'FLOUVIA OPS' : (isEn ? 'CLIENT PORTAL' : 'PORTAL DE CLIENTES')}</span>

        <div class="form-mount">
          <CustomSignIn
            lang={lang}
            product={product}
            switchAccount={switchAccount}
            redirectPath={redirectPath}
            callbackPath={callbackPath}
            client:load
          />
        </div>

        <div class="secure-badge">
          <span class="dot-secure"></span>
          {isEn ? 'SECURE SESSION' : 'SESIÓN SEGURA'}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .login-root {
    position: relative;
    width: 100%;
    min-height: calc(100dvh - 140px);
    padding: 2rem 5% 4rem;
    background-color: #ffffff;
    display: flex;
    align-items: center;
    overflow: clip;
  }

  .login-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 1080px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 5rem;
    align-items: center;
  }

  .brand-col {
    display: flex;
    flex-direction: column;
    padding-right: 1rem;
  }

  .eyebrow {
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #888;
    margin-bottom: 1.4rem;
  }

  .brand-heading {
    font-family: var(--font-sans), sans-serif;
    font-size: clamp(2.4rem, 4vw, 3.8rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    font-weight: 760;
    color: var(--color-text);
    margin: 0 0 1.6rem;
  }

  .brand-desc {
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text-muted);
    max-width: 32ch;
    margin: 0 0 2.4rem;
  }

  .access-note {
    display: flex;
    align-items: center;
    gap: .8rem;
    max-width: 25rem;
    padding: .85rem 1rem;
    border-radius: 14px;
    background: rgba(118,118,128,.08);
    border: 1px solid rgba(0,0,0,.025);
  }

  .login-root.is-ops .access-note-icon { color: #0a192f; background: rgba(10,25,47,.08); }
  .login-root.is-ops .brand-heading { max-width: 8.5ch; }
  .login-root.is-ops .brand-col { position: relative; }
  .login-root.is-ops .brand-col::before {
    content: '';
    width: 42px;
    height: 3px;
    margin-bottom: 2rem;
    border-radius: 100px;
    background: #0a192f;
  }

  .access-note-icon {
    width: 26px;
    height: 26px;
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    border-radius: 8px;
    color: #0071e3;
    background: rgba(0,113,227,.1);
  }

  .access-note-icon svg {
    width: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .access-note p {
    margin: 0;
    color: var(--color-text-muted);
    font-size: .84rem;
    line-height: 1.4;
  }

  .form-col {
    display: flex;
    justify-content: flex-end;
  }

  .form-wrap {
    width: 100%;
    max-width: 400px;
  }

  .form-eyebrow {
    display: block;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: #888;
    margin-bottom: 1.8rem;
    padding-bottom: 1.4rem;
    position: relative;
  }

  .form-eyebrow::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: 1px;
    background: linear-gradient(to right, rgba(0, 0, 0, 0.12), transparent);
  }

  .secure-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 2rem;
    font-size: 0.65rem;
    font-weight: 800;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: #10b981;
  }

  .dot-secure {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #10b981;
  }

  @media (max-width: 920px) {
    .login-root {
      align-items: flex-start;
      min-height: auto;
      padding-top: 1rem;
    }
    .login-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .brand-col { padding-right: 0; }
    .brand-desc { max-width: none; }
    .form-col { justify-content: flex-start; }
    .form-wrap { max-width: 440px; }
    .login-root.is-ops .brand-heading { max-width: none; }
  }

</style>

<style is:global>
  .js-anim .login-anim { opacity: 0; }
</style>

<script>
  import { gsap } from 'gsap';

  document.addEventListener('DOMContentLoaded', () => {
    const elements = gsap.utils.toArray<HTMLElement>('.login-anim');
    if (!elements.length) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      gsap.set(elements, { opacity: 1, y: 0 });
      return;
    }

    gsap.set(elements, { opacity: 0, y: 14 });
    gsap.to(elements, {
      opacity: 1,
      y: 0,
      duration: 0.95,
      ease: 'power2.out',
      stagger: 0.09,
      delay: 0.1,
      clearProps: 'transform',
    });
  });
</script>
