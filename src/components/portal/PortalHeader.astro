---
interface Props {
  title?: string;
  titleEd?: string;
  subtitle?: string;
  backHref: string;
  lang: 'es' | 'en';
}

const { title, titleEd, subtitle, backHref, lang } = Astro.props;
---

<header class="app-page-header">
  <div class="app-page-toolbar">
    <div class="app-page-toolbar-left">
      <a href={backHref} class="app-back-button" aria-label={lang === 'en' ? 'Back' : 'Volver'}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m14.5 6-6 6 6 6" /></svg>
      </a>
      <slot name="topbar-left" />
    </div>
    <div class="app-page-toolbar-right">
      <slot name="topbar-right" />
      <span class="app-private-status"><span></span>{lang === 'en' ? 'Private' : 'Privado'}</span>
    </div>
  </div>

  {title && (
    <div class="app-page-title-row">
      <div>
        <h1>{title}{titleEd && <> {titleEd}</>}</h1>
        {subtitle && <p>{subtitle}</p>}
      </div>
      <slot name="title-right" />
    </div>
  )}
</header>

<style>
  .app-page-header { margin-bottom: 2rem; font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Inter", system-ui, sans-serif; animation: app-header-enter 320ms cubic-bezier(.25,.1,.25,1) both; }
  @keyframes app-header-enter { from { opacity: 0; transform: translateY(8px); } }
  .app-page-toolbar, .app-page-toolbar-left, .app-page-toolbar-right, .app-page-title-row { display: flex; align-items: center; }
  .app-page-toolbar { justify-content: space-between; min-height: 38px; margin-bottom: 1.55rem; }
  .app-page-toolbar-left, .app-page-toolbar-right { gap: .65rem; }
  .app-back-button { width: 36px; height: 36px; display: grid; place-items: center; border-radius: 50%; background: rgba(118,118,128,.1); color: #3a3a3c; text-decoration: none; transition: background 160ms, transform 120ms; }
  .app-back-button:hover { background: rgba(118,118,128,.17); }
  .app-back-button:active { transform: scale(.94); }
  .app-back-button svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .app-private-status { display: inline-flex; align-items: center; gap: .4rem; min-height: 28px; padding: 0 .7rem; border: 1px solid rgba(0,0,0,.07); border-radius: 999px; background: rgba(255,255,255,.62); color: #6e6e73; font-size: .64rem; font-weight: 600; }
  .app-private-status > span { width: 6px; height: 6px; border-radius: 50%; background: #30a46c; }
  .app-page-title-row { justify-content: space-between; align-items: flex-end; gap: 1.5rem; }
  .app-page-title-row h1 { margin: 0; color: #1d1d1f; font-size: clamp(2rem, 4vw, 3.35rem); font-weight: 700; line-height: 1.02; letter-spacing: -.045em; }
  .app-page-title-row p { max-width: 600px; margin: .7rem 0 0; color: #6e6e73; font-size: .92rem; line-height: 1.55; }
  @media (max-width: 640px) {
    .app-page-header { margin-bottom: 1.5rem; }
    .app-page-title-row { align-items: flex-start; flex-direction: column; }
    .app-page-title-row h1 { font-size: clamp(1.85rem, 9vw, 2.65rem); }
  }
  @media (prefers-reduced-motion: reduce) { .app-page-header { animation: none; } }
</style>
