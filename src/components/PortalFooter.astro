---
interface Props {
  product?: 'OS' | 'OPS';
}
const { product = 'OS' } = Astro.props;
const isOps = product === 'OPS';
const isEn = !isOps && Astro.url.pathname.startsWith('/en');
const path = (value: string) => isEn ? `/en${value}` : value;
---

<footer class="portal-footer">
  <div class="portal-footer-line"></div>
  <div class="portal-footer-inner">
    <div class="portal-footer-meta">
      <span>FLOUVIA {product} · {isOps ? 'CENTRO DE OPERACIÓN' : (isEn ? 'CLIENT SPACE' : 'ESPACIO DE CLIENTE')}</span>
      <span class="portal-footer-status"><i></i>{isEn ? 'SYSTEMS OPERATIONAL' : 'SISTEMAS OPERATIVOS'}</span>
    </div>

    <div class="portal-footer-grid">
      <div class="portal-footer-brand">
        <img src="/imgs/logo-flouvia-1.svg" alt="Flouvia" />
        <h2>{isOps ? 'Cada cliente, atendido con claridad.' : (isEn ? 'Your operation, in one place.' : 'Tu operación, en un solo lugar.')}</h2>
        <a href="mailto:hola@flouvia.com">hola@flouvia.com <span>→</span></a>
      </div>

      {isOps ? (
        <nav class="portal-footer-nav" aria-label="Navegación de Ops">
          <div><span>01</span><strong>Operación</strong><a href="/#inbox">Bandeja</a><a href="/#clients">Clientes</a></div>
          <div><span>02</span><strong>Productos</strong><a href="https://os.flouvia.com/dashboard">Flouvia OS</a><a href="https://flouvia.com/">Sitio público</a></div>
          <div><span>03</span><strong>Equipo</strong><a href="mailto:hola@flouvia.com">Contacto</a><a href="https://flouvia.com/privacidad">Privacidad</a></div>
        </nav>
      ) : (
        <nav class="portal-footer-nav" aria-label={isEn ? 'Portal navigation' : 'Navegación del portal'}>
          <div><span>01</span><strong>Portal</strong><a href={path('/dashboard')}>Dashboard</a><a href={path('/colaboracion')}>{isEn ? 'Shared work' : 'Trabajo compartido'}</a><a href={path('/boveda')}>{isEn ? 'Vault' : 'Bóveda'}</a></div>
          <div><span>02</span><strong>{isEn ? 'Progress' : 'Avance'}</strong><a href={path('/roadmap')}>Roadmap</a><a href={path('/entorno')}>{isEn ? 'Environment' : 'Entorno'}</a><a href={path('/facturacion')}>{isEn ? 'Billing' : 'Facturación'}</a></div>
          <div><span>03</span><strong>{isEn ? 'Help' : 'Ayuda'}</strong><a href={path('/soporte')}>{isEn ? 'Support' : 'Soporte'}</a><a href={path('/calendario')}>{isEn ? 'Calendar' : 'Calendario'}</a><a href={path('/privacidad-portal')}>{isEn ? 'Privacy' : 'Privacidad'}</a></div>
        </nav>
      )}
    </div>

    <div class="portal-footer-bottom">
      <span>© 2026 Flouvia. {isEn ? 'All rights reserved.' : 'Todos los derechos reservados.'}</span>
      <span>{isOps ? 'Uso exclusivo del equipo Flouvia' : (isEn ? 'Private client environment' : 'Entorno privado de cliente')}</span>
    </div>
  </div>
</footer>

<style>
  .portal-footer { position: relative; overflow: hidden; color: #fff; background: radial-gradient(ellipse at 24% 12%, #112440 0%, #0a192f 58%, #050b14 100%); font-family: Inter, -apple-system, BlinkMacSystemFont, system-ui, sans-serif; }
  .portal-footer-line { height: 1px; background: linear-gradient(90deg, transparent, rgba(255,255,255,.2) 20%, rgba(255,255,255,.2) 80%, transparent); }
  .portal-footer-inner { width: min(1240px, 90%); margin: 0 auto; padding: 52px 0 28px; }
  .portal-footer-meta { display: flex; align-items: center; justify-content: space-between; gap: 1.5rem; margin-bottom: 50px; color: rgba(255,255,255,.38); font-size: .59rem; font-weight: 680; letter-spacing: .13em; }
  .portal-footer-status { display: inline-flex; align-items: center; gap: 8px; }
  .portal-footer-status i { width: 6px; height: 6px; border-radius: 50%; background: #16b981; box-shadow: 0 0 0 5px rgba(22,185,129,.08); }
  .portal-footer-grid { display: grid; grid-template-columns: 5fr 7fr; gap: 5rem; padding-bottom: 50px; }
  .portal-footer-brand { display: flex; flex-direction: column; align-items: flex-start; }
  .portal-footer-brand img { width: 124px; height: auto; margin-bottom: 26px; }
  .portal-footer-brand h2 { max-width: 390px; margin: 0 0 28px; color: #fff; font-size: clamp(1.45rem, 2.4vw, 2.2rem); line-height: 1.08; letter-spacing: -.04em; }
  .portal-footer-brand a { display: inline-flex; align-items: center; gap: 12px; padding-bottom: 10px; border-bottom: 1px solid rgba(255,255,255,.15); color: rgba(255,255,255,.82); text-decoration: none; font-size: .9rem; font-weight: 560; transition: color .3s, border-color .3s; }
  .portal-footer-brand a span { color: #7f91aa; transition: transform .4s cubic-bezier(.16,1,.3,1); }
  .portal-footer-brand a:hover { color: #fff; border-color: rgba(255,255,255,.42); }
  .portal-footer-brand a:hover span { transform: translateX(5px); }
  .portal-footer-nav { display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .portal-footer-nav > div { display: flex; flex-direction: column; align-items: flex-start; }
  .portal-footer-nav div > span { margin-bottom: 8px; color: rgba(255,255,255,.28); font-size: .7rem; }
  .portal-footer-nav strong { margin-bottom: 24px; color: rgba(255,255,255,.52); font-size: .62rem; letter-spacing: .08em; text-transform: uppercase; }
  .portal-footer-nav a { margin-bottom: 13px; color: #8998af; text-decoration: none; font-size: .77rem; transition: color .3s, transform .4s cubic-bezier(.16,1,.3,1); }
  .portal-footer-nav a:hover { color: #fff; transform: translateX(4px); }
  .portal-footer-bottom { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-top: 24px; border-top: 1px solid rgba(255,255,255,.08); color: #66758c; font-size: .65rem; }
  @media (max-width: 820px) { .portal-footer-grid { grid-template-columns: 1fr; gap: 3.5rem; } }
  @media (max-width: 560px) {
    .portal-footer-inner { width: calc(100% - 36px); padding-top: 38px; }
    .portal-footer-meta { align-items: flex-start; flex-direction: column; margin-bottom: 38px; }
    .portal-footer-grid { padding-bottom: 38px; }
    .portal-footer-nav { grid-template-columns: repeat(2, 1fr); row-gap: 2.4rem; }
    .portal-footer-bottom { align-items: flex-start; flex-direction: column; }
  }
</style>
