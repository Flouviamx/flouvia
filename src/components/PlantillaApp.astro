.ad-plan-featured .ad-plan-cycle { color: rgba(255,255,255,.5); }
.ad-plan-tagline { font-size: 0.88rem; line-height: 1.45; color: var(--color-text-muted); margin-bottom: 1.6rem; min-height: 2.5em; }
.ad-plan-featured .ad-plan-tagline { color: rgba(255,255,255,.62); }
.ad-plan-feats { list-style: none; margin: 0 0 1.6rem; padding: 1.6rem 0 0; border-top: 1px solid var(--color-border); display: flex; flex-direction: column; gap: 0.8rem; flex-grow: 1; }
.ad-plan-featured .ad-plan-feats { border-top-color: rgba(255,255,255,.12); }
.ad-plan-feat { display: flex; align-items: flex-start; gap: 10px; font-size: 0.87rem; line-height: 1.4; color: #333; }
.ad-plan-featured .ad-plan-feat { color: rgba(255,255,255,.85); }
.ad-plan-feat svg { color: #10b981; flex-shrink: 0; margin-top: 3px; }
.ad-plan-note { font-size: 0.74rem; line-height: 1.4; color: var(--color-text-muted); margin-bottom: 1.1rem; }
.ad-plan-featured .ad-plan-note { color: rgba(255,255,255,.55); }
.ad-plan-btn { display: inline-flex; align-items: center; justify-content: center; padding: 15px 28px; border-radius: 100px; text-decoration: none; font-size: 0.92rem; font-weight: 700; transition: transform .5s var(--ease-spring), box-shadow .5s var(--ease-spring); border: 1px solid var(--color-border); color: var(--color-text); background: #fff; }
.ad-plan-btn:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgba(10,25,47,0.12); }
.ad-plan-btn-primary { background: #fff; color: var(--color-blue-deep); border-color: transparent; box-shadow: 0 10px 24px rgba(255,255,255,0.14); }
.ad-plan-btn-primary:hover { box-shadow: 0 18px 38px rgba(255,255,255,0.22); }
.ad-plans-foot { font-size: 0.82rem; line-height: 1.6; color: var(--color-text-muted); margin: 2rem 0 0; max-width: 720px; }

/* FAQ */
.ad-faq-section { padding: 9rem 0; background: var(--color-bg); border-top: 1px solid var(--color-border); position: relative; overflow: clip; }
.ad-faq-section .container { z-index: 1; }
.ad-faq-container { display: grid; grid-template-columns: 360px 1fr; gap: 6rem; align-items: start; }
.ad-faq-head { position: sticky; top: 120px; }
.ad-faq-heading { font-size: clamp(2rem, 4vw, 3rem); font-weight: 700; letter-spacing: -1.2px; margin: 0 0 1rem 0; color: var(--color-text); line-height: 1.1; }
.ad-faq-sub { font-size: 1.05rem; color: var(--color-text-muted); line-height: 1.5; margin: 0; max-width: 280px; }

.ad-faq-list { display: flex; flex-direction: column; border-top: 1px solid var(--color-border); position: relative; z-index: 1; }
.faq-item { border-bottom: 1px solid var(--color-border); }

.faq-q { width: 100%; background: none; border: none; text-align: left; padding: 2rem 0; display: flex; align-items: center; justify-content: space-between; gap: 2rem; cursor: pointer; font-family: var(--font-sans); font-size: 1.3rem; font-weight: 500; color: var(--color-text); letter-spacing: -0.4px; transition: color 0.3s ease; }
.faq-q:hover { color: #86868b; }

.faq-icon-wrap { position: relative; width: 14px; height: 14px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; color: var(--color-text); transition: color 0.3s ease; }
.faq-q:hover .faq-icon-wrap { color: #86868b; }
.faq-icon-line { position: absolute; background: currentColor; border-radius: 1px; transition: transform 0.5s var(--ease-spring), opacity 0.5s ease; }
.faq-icon-h { width: 14px; height: 1.5px; }
.faq-icon-v { width: 1.5px; height: 14px; }

.faq-item.is-open .faq-icon-v { transform: rotate(90deg); opacity: 0; }
.faq-item.is-open .faq-icon-h { transform: rotate(180deg); }
.faq-item.is-open .faq-q { color: var(--color-text); }
.faq-item.is-open .faq-icon-wrap { color: var(--color-text); }

.faq-a { height: 0; overflow: hidden; opacity: 0; }
.faq-a-inner { padding: 0 3rem 2.5rem 0; }
.faq-a-inner p { margin: 0; font-size: 1.05rem; line-height: 1.6; color: #6e6e73; max-width: 680px; font-weight: 400; }

/* NAV */
.ad-nav { padding: 3.5rem 0; background: var(--color-bg); border-top: 1px solid var(--color-border); }
.ad-nav-row { display: flex; justify-content: space-between; align-items: center; gap: 2rem; }
.ad-nav-all { display: flex; align-items: center; gap: 12px; font-size: 0.82rem; font-weight: 700; color: var(--color-text-muted); text-decoration: none; flex-direction: row-reverse; transition: color .2s, gap .3s var(--ease-smooth); }
.ad-nav-all:hover { color: var(--color-text); gap: 16px; }
.ad-nav-all .ad-nav-circ { transform: rotate(180deg); }
.ad-nav-next { display: flex; align-items: center; gap: 1.5rem; text-decoration: none; color: var(--color-text); transition: gap .3s var(--ease-smooth); }
.ad-nav-next:hover { gap: 2rem; }
.ad-nav-next-txt { text-align: right; display: flex; flex-direction: column; gap: 0.15rem; }
.ad-nav-lbl { font-size: 0.58rem; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; color: var(--color-text-muted); }
.ad-nav-brand { font-size: 1.7rem; font-weight: 800; letter-spacing: -1px; line-height: 1; }
.ad-nav-circ { width: 46px; height: 46px; border-radius: 50%; border: 1.5px solid rgba(0,0,0,.12); display: flex; align-items: center; justify-content: center; transition: all .4s var(--ease-spring); flex-shrink: 0; color: var(--color-text); }
.ad-nav-next:hover .ad-nav-circ { background: var(--color-blue-deep); border-color: var(--color-blue-deep); color: #fff; transform: rotate(-45deg) scale(1.08); }

/* CTA */
.ad-cta-section { padding: 4rem 0 6rem; background: var(--color-bg-soft); }
.ad-cta-card { background: radial-gradient(120% 100% at 50% 0%, #152744 0%, #050b14 100%); padding: 5rem 6rem; position: relative; box-shadow: 0 20px 40px rgba(5,11,20,.15), 0 50px 100px rgba(5,11,20,.22); transition: transform 0.6s var(--ease-spring); }
.ad-cta-card:hover { transform: scale(1.012); }
.ad-cta-inner { display: flex; justify-content: space-between; align-items: center; gap: 3rem; position: relative; z-index: 2; }
.ad-cta-eye { font-size: 0.6rem; font-weight: 800; letter-spacing: 4px; color: rgba(255,255,255,.3); text-transform: uppercase; margin: 0 0 1rem; }
.ad-cta-title { font-size: clamp(2.2rem,3.4vw,3.1rem); font-weight: 800; color: #fff; line-height: 1.08; letter-spacing: -1.2px; margin: 0; max-width: 18ch; }
.ad-cta-sub { margin: 1.3rem 0 0; color: rgba(255,255,255,.66); font-size: 1.02rem; line-height: 1.55; max-width: 440px; }
.ad-cta-action { display: flex; flex-direction: column; align-items: flex-end; gap: 1.1rem; flex-shrink: 0; }
.ad-cta-badge { display: inline-flex; align-items: center; gap: 8px; font-size: 0.68rem; font-weight: 700; letter-spacing: 0.5px; text-transform: uppercase; color: rgba(255,255,255,.6); }
.ad-cta-badge-dot { width: 6px; height: 6px; border-radius: 50%; background: #10b981; box-shadow: 0 0 10px rgba(16,185,129,.6); animation: ad-badge-pulse 2s infinite; }
@keyframes ad-badge-pulse { 0%,100% { opacity: 1; } 50% { opacity: .4; } }
.ad-cta-btn { position: relative; background: #fff; color: var(--color-blue-deep); padding: 20px 44px; border-radius: 100px; text-decoration: none; font-size: 1rem; font-weight: 700; overflow: hidden; transition: .5s var(--ease-spring); display: inline-flex; align-items: center; white-space: nowrap; box-shadow: inset 0 0 0 1px rgba(0,0,0,.1), 0 10px 20px rgba(255,255,255,.1); }
.ad-cta-btn:hover { transform: translateY(-4px); box-shadow: inset 0 0 0 1px rgba(0,0,0,.1), 0 20px 40px rgba(255,255,255,.2); }

/* RESPONSIVE */
@media (max-width: 1024px) {
  .ad-hero-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  .ad-card { max-width: 360px; }
  .ad-how-grid { grid-template-columns: 1fr 1fr; }
  .ad-how-step { border-bottom: 1px solid var(--color-border); padding: 2.2rem 1.6rem 2.2rem 0; }
  .ad-how-step:nth-child(2n) { border-right: none; padding-right: 0; }
  .ad-how-step:nth-child(2n) { padding-left: 1.6rem; }
  .ad-how-step:nth-child(2n)::before { left: 1.6rem; }
  .ad-plans-grid { grid-template-columns: repeat(2, 1fr); }
  
  .ad-faq-container { grid-template-columns: 1fr; gap: 3rem; }
  .ad-faq-head { position: static; max-width: 100%; }
  .ad-faq-sub { max-width: 100%; }
}
@media (max-width: 768px) {
  .ad-hero { padding: 10rem 0 0; }
  .ad-breadcrumb { margin-bottom: 2.5rem; }
  .ad-store-chip { margin-left: 0; }
  .ad-name { letter-spacing: -1.5px; }
  .ad-cta-row { flex-direction: column; align-items: stretch; }
  .ad-install-btn { width: 100%; justify-content: center; }
  .ad-card { max-width: 100%; }
  .ad-metrics { grid-template-columns: 1fr 1fr; margin-top: 2.5rem; }
  .ad-metric { padding: 1.4rem 1rem; }
  .ad-visual-section { padding: 2.5rem 0; }
  .ad-visual-wrap { min-height: 200px; border-radius: 18px; }
  .ad-how-section, .ad-plans-section, .ad-faq-section { padding: 5rem 0; }
  .ad-how-head, .ad-plans-head { margin-bottom: 2.8rem; }
  .ad-how-grid { grid-template-columns: 1fr; }
  .ad-how-step, .ad-how-step:nth-child(2n) { border-right: none; padding: 2rem 0; }
  .ad-how-step:nth-child(2n)::before { left: 0; }
  .ad-plans-grid { grid-template-columns: 1fr; max-width: 100%; }
  .ad-plan { padding: 2rem; }
  .ad-sec-wm { font-size: 34vw; bottom: -1.5vw; }
  .ad-body-section { padding: 5rem 0; }
  .ad-body-grid { grid-template-columns: 1fr; gap: 3rem; }
  .ad-nav-row { flex-direction: column; align-items: stretch; gap: 2rem; }
  .ad-nav-next { justify-content: space-between; }
  .ad-nav-next-txt { text-align: left; }
  .ad-cta-section { padding: 3rem 5% 5rem; }
  .ad-cta-card { padding: 3.5rem 2rem; }
  .ad-cta-inner { flex-direction: column; align-items: center; gap: 2.5rem; }
  .ad-cta-text { text-align: center; }
  .ad-cta-title { max-width: 100%; }
  .ad-cta-action { align-items: center; width: 100%; }
  .ad-cta-btn { width: 100%; justify-content: center; padding: 18px 0; }

  .ad-faq-heading { font-size: 2.2rem; }
  .faq-q { font-size: 1.1rem; padding: 1.5rem 0; gap: 1rem; }
  .faq-a-inner { padding: 0 1rem 1.5rem 0; }
  .faq-a-inner p { font-size: 0.95rem; }
}
</style>

<script>
import { gsap } from 'gsap';
import { ScrollTrigger } from 'gsap/ScrollTrigger';
gsap.registerPlugin(ScrollTrigger);

const robustRefresh = () => {
  const winLoad = new Promise<void>((resolve) => {
    if (document.readyState === 'complete') resolve();
    else window.addEventListener('load', () => resolve(), { once: true });
  });
  const fontsReady = (document as any).fonts?.ready ?? Promise.resolve();
  Promise.all([winLoad, fontsReady]).then(() => setTimeout(() => ScrollTrigger.refresh(), 120));
};
robustRefresh();

document.addEventListener('DOMContentLoaded', () => {
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduced) return;

  const EASE = 'power2.out', DUR = 0.9, Y = 14;

  const heroSel = ['.ad-breadcrumb', '.ad-eyebrow', '.ad-name', '.ad-tagline', '.ad-desc', '.ad-cta-row', '.ad-card', '.ad-metrics'];
  const heroEls = heroSel.map(s => document.querySelector<HTMLElement>(s)).filter((el): el is HTMLElement => !!el);
  if (heroEls.length) {
    gsap.set(heroEls, { opacity: 0, y: 12 });
    const tl = gsap.timeline({ defaults: { ease: EASE } });
    heroEls.forEach((el, i) => { tl.to(el, { opacity: 1, y: 0, duration: i === 2 ? 1.1 : 0.95 }, i === 0 ? 0 : 0.08 + i * 0.09); });
  }

  const reveal = (
    targets: string | HTMLElement | NodeListOf<Element> | HTMLElement[],
    opts: { trigger?: string | HTMLElement; start?: string; y?: number; dur?: number; stagger?: number; delay?: number } = {}
  ) => {
    const els = gsap.utils.toArray<HTMLElement>(targets as any);
    if (!els.length) return;
    gsap.set(els, { opacity: 0, y: opts.y ?? Y });
    ScrollTrigger.create({
      trigger: opts.trigger ?? els[0], start: opts.start ?? 'top 85%', once: true,
      onEnter: () => gsap.to(els, {
        opacity: 1, y: 0, duration: opts.dur ?? DUR, ease: EASE,
        stagger: opts.stagger ?? 0.08, delay: opts.delay ?? 0, clearProps: 'transform,opacity',
      }),
    });
  };

  const drawRule = (rule: HTMLElement | null, trigger: HTMLElement) => {
    if (!rule) return;
    gsap.set(rule, { scaleX: 0, transformOrigin: 'left center' });
    ScrollTrigger.create({
      trigger, start: 'top 82%', once: true,
      onEnter: () => gsap.to(rule, { scaleX: 1, duration: 0.9, ease: 'power3.inOut' }),
    });
  };

  reveal('#ad-visual', { trigger: '#ad-visual', y: 24, dur: 1.0, start: 'top 86%' });
  reveal('#ad-demo-link', { trigger: '#ad-demo-link', y: 12, dur: 0.8, start: 'top 92%' });

  const colProblem = document.getElementById('ad-problem');
  if (colProblem) {
    reveal(colProblem.querySelectorAll('.ad-col-eye, .ad-problem-text, .ad-related'), { trigger: colProblem, y: 14, stagger: 0.08, start: 'top 84%' });
    drawRule(colProblem.querySelector('.ad-col-rule'), colProblem);
  }
  const colFeatures = document.getElementById('ad-features');
  if (colFeatures) {
    reveal(colFeatures.querySelectorAll('.ad-col-eye, .ad-feature'), { trigger: colFeatures, y: 14, stagger: 0.07, start: 'top 82%' });
    drawRule(colFeatures.querySelector('.ad-col-rule'), colFeatures);
  }

  const howHead = document.getElementById('ad-how-head');
  if (howHead) reveal(howHead.querySelectorAll('.ad-sec-eye, .ad-sec-title, .ad-sec-sub'), { trigger: '.ad-how-section', y: 14, stagger: 0.08, start: 'top 82%' });
  reveal('.ad-how-step', { trigger: '.ad-how-grid', y: 18, dur: 0.95, stagger: 0.1, start: 'top 84%' });

  const plansHead = document.getElementById('ad-plans-head');
  if (plansHead) reveal(plansHead.querySelectorAll('.ad-sec-eye, .ad-sec-title'), { trigger: '.ad-plans-section', y: 14, stagger: 0.08, start: 'top 82%' });
  reveal('.ad-plan', { trigger: '.ad-plans-grid', y: 22, dur: 1.0, stagger: 0.1, start: 'top 84%' });

  const faqHead = document.getElementById('ad-faq-head');
  if (faqHead) reveal(faqHead.querySelectorAll('.ad-faq-heading, .ad-faq-sub'), { trigger: '.ad-faq-section', y: 14, stagger: 0.08, start: 'top 82%' });
  reveal('.faq-item', { trigger: '#faq-list', y: 14, dur: 0.9, stagger: 0.08, start: 'top 86%' });

  const faqItems = document.querySelectorAll('.faq-item');
  faqItems.forEach(item => {
    const q = item.querySelector('.faq-q');
    const a = item.querySelector('.faq-a');
    
    q?.addEventListener('click', () => {
      const isOpen = item.classList.contains('is-open');
      
      faqItems.forEach(other => {
        if (other !== item && other.classList.contains('is-open')) {
          other.classList.remove('is-open');
          other.querySelector('.faq-q')?.setAttribute('aria-expanded', 'false');
          gsap.to(other.querySelector('.faq-a'), { height: 0, opacity: 0, duration: 0.5, ease: 'power3.inOut' });
        }
      });

      if (isOpen) {
        item.classList.remove('is-open');
        q.setAttribute('aria-expanded', 'false');
        gsap.to(a, { height: 0, opacity: 0, duration: 0.5, ease: 'power3.inOut' });
      } else {
        item.classList.add('is-open');
        q.setAttribute('aria-expanded', 'true');
        gsap.to(a, { height: 'auto', opacity: 1, duration: 0.5, ease: 'power3.inOut' });
      }
    });
  });

  const ctaCard = document.getElementById('ad-cta');
  if (ctaCard) {
    reveal(ctaCard, { trigger: ctaCard, y: 24, dur: 1.0, start: 'top 84%' });
    reveal(ctaCard.querySelectorAll('.ad-cta-text > *, .ad-cta-action'), { trigger: ctaCard, y: 12, stagger: 0.08, delay: 0.15, start: 'top 84%' });
  }
});
</script>
