.ad-plans-grid { display: grid; grid-template-columns: repeat(var(--plan-cols, 2), 1fr); gap: 1.2rem; align-items: stretch; position: relative; z-index: 1; }
.ad-plan { display: flex; flex-direction: column; border: 1px solid var(--color-border); border-radius: 22px; padding: 2rem 1.8rem; background: var(--color-bg-soft); position: relative; }
.ad-plan-featured { background: radial-gradient(120% 100% at 50% 0%, #152744 0%, #050b14 100%); border-color: transparent; box-shadow: 0 30px 70px -30px rgba(10,25,47,0.4); }
.ad-plan-tag { position: absolute; top: -11px; left: 1.8rem; font-size: 0.55rem; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; color: #fff; background: #10b981; padding: 5px 11px; border-radius: 100px; box-shadow: 0 6px 16px rgba(16,185,129,0.35); }
.ad-plan-name { font-size: 0.68rem; font-weight: 800; letter-spacing: 2.5px; text-transform: uppercase; color: #999; }
.ad-plan-featured .ad-plan-name { color: rgba(255,255,255,.55); }
.ad-plan-price-row { display: flex; align-items: baseline; gap: 8px; flex-wrap: wrap; margin: 0.7rem 0 0.6rem; }
